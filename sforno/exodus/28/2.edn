{:tier :glm-5.2, :verse 2, :comments ["<b>Para honra.</b> Por el honor de El, bendito sea, siendo estas vestiduras sagradas para su servicio." "<b>Y para esplendor.</b> Para que el sacerdote sea un maestro inspirador de temor reverencial para todos a su alrededor — siendo ellos los discípulos inscritos sobre su corazón y sus hombros."], :book "exodus", :voice :sforno, :lang :es, :chapter 28, :timestamp "2026-07-27T20:07:52.668418844Z", :translated-from :en, :model "glm-5.2"}