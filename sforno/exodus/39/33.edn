{:tier :glm-5.2, :verse 33, :comments ["<b>Y trajeron el Mishkán.</b> Las cortinas de obra primorosa." "<b>La Ohel.</b> Las cortinas de pelo de cabra." "<b>Y todos sus utensilios.</b> Los del Mishkán — pues los broches, las tablas, las barras, las columnas y las basas eran todos utensilios del Mishkán."], :book "exodus", :voice :sforno, :lang :es, :chapter 39, :timestamp "2026-07-27T20:08:48.394300639Z", :translated-from :en, :model "glm-5.2"}