{:tier :glm-5.2, :verse 16, :comments ["<b>Y he aquí vuestros siervos son azotados, y el pecado es de tu pueblo.</b> He aquí, nosotros somos los azotados, y los hombres del pecado que nos azotan son todos de tu pueblo — y es propio que vosotros os celéis por ambas cosas."], :book "exodus", :voice :sforno, :lang :es, :chapter 5, :timestamp "2026-07-27T20:05:07.457427187Z", :translated-from :en, :model "glm-5.2"}