{:tier :glm-5.2, :verse 18, :comments ["<b>También este pueblo que está contigo.</b> Tu corte." "<b>No podrás hacerlo tú solo.</b> Oír todos los asuntos de los grandes, y junto con esto oír a todos los que necesitan hablar contigo, respecto a asuntos para los cuales nadie sino tú bastará."], :book "exodus", :voice :sforno, :lang :es, :chapter 18, :timestamp "2026-07-27T20:06:40.875408841Z", :translated-from :en, :model "glm-5.2"}