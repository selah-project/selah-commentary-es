{:tier :glm-5.2, :verse 42, :comments ["<b>Porque son mis siervos.</b> Aunque porque este fue y adquirió un amo para sí mismo sería merecedor de toda sujeción, sin embargo, en cuanto que es mi siervo, no está en su poder venderse a sí mismo como esclavo permanente."], :book "leviticus", :voice :sforno, :lang :es, :chapter 25, :timestamp "2026-07-27T20:17:19.676269781Z", :translated-from :en, :model "glm-5.2"}