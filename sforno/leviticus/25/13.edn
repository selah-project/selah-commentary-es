{:tier :glm-5.2, :verse 13, :comments ["<b>Volveréis cada uno a su posesión.</b> Y les está permitido a los dueños que vuelven a ella tomar posesión de ella como propiedad y usarla para construir casas, palomares y rediles de ovejas y similares, aparte de trabajar la tierra y cultivar sus frutos."], :book "leviticus", :voice :sforno, :lang :es, :chapter 25, :timestamp "2026-07-27T20:17:12.129157333Z", :translated-from :en, :model "glm-5.2"}