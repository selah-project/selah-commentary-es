{:tier :glm-5.2, :verse 13, :comments ["<b>Si yerran y se les oculta un asunto a los ojos de la asamblea.</b> Pues aunque ellos son los ojos de la asamblea, que se espera que vean en lugar de los demás, no vieron bien para sí mismos — y también sobre ellos se dice."], :book "leviticus", :voice :sforno, :lang :es, :chapter 4, :timestamp "2026-07-27T20:15:20.322649240Z", :translated-from :en, :model "glm-5.2"}