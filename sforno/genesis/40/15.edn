{:tier :glm-5.2, :verse 15, :comments ["<b>Porque fui robado, y también aquí no he hecho nada.</b> Y la razón es: ciertamente me sacarás, como dices, pues en verdad se hallará que ni mi esclavitud ni mi prisión fueron a causa de ningún pecado que se haya hallado en mí."], :book "genesis", :voice :sforno, :lang :es, :chapter 40, :timestamp "2026-07-27T20:13:50.482297269Z", :translated-from :en, :model "glm-5.2"}