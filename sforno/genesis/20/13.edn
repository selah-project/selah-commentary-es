{:tier :glm-5.2, :verse 13, :comments ["<b>Elohim me hizo errar.</b> A causa de la idolatría que yo rechacé, fui obligado a salir de la casa de mi padre hacia un lugar que no conocía — no a ningún destino conocido por mí — y en este sentido soy llamado errante."], :book "genesis", :voice :sforno, :lang :es, :chapter 20, :timestamp "2026-07-27T20:11:04.039871709Z", :translated-from :en, :model "glm-5.2"}