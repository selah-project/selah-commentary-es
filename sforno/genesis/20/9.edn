{:tier :glm-5.2, :verse 9, :comments ["<b>Acciones que no debieran hacerse.</b> Causar daño a un hombre previamente desconocido para ti, con quien no tienes enemistad — y todo esto sin ningún beneficio para ti. No hay manera de que tal cosa deba hacerse."], :book "genesis", :voice :sforno, :lang :es, :chapter 20, :timestamp "2026-07-27T20:11:02.231703411Z", :translated-from :en, :model "glm-5.2"}