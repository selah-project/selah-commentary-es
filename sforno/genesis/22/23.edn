{:tier :glm-5.2, :verse 23, :comments ["<b>Y Betuel engendró a Rivká.</b> El narrador relata que Betuel — que era de la familia de la gran señora — engendró a Rivká, para que la buena nueva fuera que encontraría una esposa para su hijo en la casa de su padre y no necesitaría unirse a los cananeos."], :book "genesis", :voice :sforno, :lang :es, :chapter 22, :timestamp "2026-07-27T20:11:17.084336251Z", :translated-from :en, :model "glm-5.2"}