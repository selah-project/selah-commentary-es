{:tier :glm-5.2, :verse 24, :comments ["<b>Y expulsó al hombre.</b> Para que él y su descendencia no regresaran allí de nuevo." "<b>Y colocó.</b> Entonces, antes de que hubieran partido." "<b>Para guardar el camino del árbol de la vida.</b> Para que no se desviaran, al partir, hacia aquel árbol y comieran de él."], :book "genesis", :voice :sforno, :lang :es, :chapter 3, :timestamp "2026-07-27T20:09:26.107446907Z", :translated-from :en, :model "glm-5.2"}