{:tier :glm-5.2, :verse 24, :comments ["<b>Produzca la tierra alma viviente.</b> La animalidad es una adición sobre la vegetatividad." "<b>Y así fue.</b> Sin adición ni disminución, de modo que si surgiera un compuesto de dos especies, no se reproduciría."], :book "genesis", :voice :sforno, :lang :es, :chapter 1, :timestamp "2026-07-27T20:09:00.612508005Z", :translated-from :en, :model "glm-5.2"}