{:tier :glm-5.2, :verse 15, :comments ["<b>Para dar luz sobre la tierra.</b> Para que sobre ella llegara, de los luminares, una luz debidamente combinada para sus habitantes." "<b>Y así fue.</b> Esa combinación necesaria se cumplió por Su mandato."], :book "genesis", :voice :sforno, :lang :es, :chapter 1, :timestamp "2026-07-27T20:08:58.127878670Z", :translated-from :en, :model "glm-5.2"}