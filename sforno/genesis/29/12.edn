{:tier :glm-5.2, :verse 12, :comments ["<b>Porque él es el hermano de su padre.</b> Para dar a conocer que no transgredió la propiedad cuando la besó." "<b>Y que él es el hijo de Ribká.</b> Le mencionó a Ribká, aunque ella era desconocida para Rajel, para que ella se lo dijera a su padre."], :book "genesis", :voice :sforno, :lang :es, :chapter 29, :timestamp "2026-07-27T20:12:15.676414755Z", :translated-from :en, :model "glm-5.2"}