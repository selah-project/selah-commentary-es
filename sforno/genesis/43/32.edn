{:tier :glm-5.2, :verse 32, :comments ["<b>Y le sirvieron a él aparte.</b> Para que sus hermanos no percibieran que él es hebreo." "<b>Porque los egipcios no podían.</b> Por tanto él no comía con sus hermanos, ni él ni sus hermanos con los egipcios."], :book "genesis", :voice :sforno, :lang :es, :chapter 43, :timestamp "2026-07-27T20:14:16.743041051Z", :translated-from :en, :model "glm-5.2"}