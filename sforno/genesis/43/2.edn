{:tier :glm-5.2, :verse 2, :comments ["<b>Regresa, compra para nosotros.</b> Pues él pensó que buscaban llevarse a Biniamín con ellos para destruirlo como hicieron con Iosef, como les dijo: <b>me habéis privado</b> — no que el asunto fuera como ellos habían reportado."], :book "genesis", :voice :sforno, :lang :es, :chapter 43, :timestamp "2026-07-27T20:14:11.516336551Z", :translated-from :en, :model "glm-5.2"}