{:tier :glm-5.2, :verse 7, :comments ["<b>Y envió al cuervo.</b> Para ver si el aire se había secado después de que se vieran las cumbres de los montes, de modo que el cuervo pudiera soportarlo." "<b>Y salió, yendo y volviendo.</b> Porque no podía soportarlo."], :book "genesis", :voice :sforno, :lang :es, :chapter 8, :timestamp "2026-07-27T20:09:43.955268358Z", :translated-from :en, :model "glm-5.2"}