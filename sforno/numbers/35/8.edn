{:tier :glm-5.2, :verse 8, :comments ["<b>De lo mucho harás mucho.</b> Porque lo adquirieron con dinero — y la porción pequeña que pertenecía a la tribu que tenía una parte pequeña era igual en valor monetario a la parte grande que la tribu con una porción grande dio a los levitas."], :book "numbers", :voice :sforno, :lang :es, :chapter 35, :timestamp "2026-07-27T20:20:25.501333796Z", :translated-from :en, :model "glm-5.2"}