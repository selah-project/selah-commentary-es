{:tier :glm-5.2, :verse 14, :comments ["<b>Y separarás a los levitas.</b> Separarás a los levitas acampándolos, pues ellos habitan en Mi recinto [el de Adonai]." "<b>Y los levitas serán Míos.</b> Ellos y su descendencia estarán preparados para Mi servicio."], :book "numbers", :voice :sforno, :lang :es, :chapter 8, :timestamp "2026-07-27T20:18:09.894065526Z", :translated-from :en, :model "glm-5.2"}