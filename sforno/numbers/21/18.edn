{:tier :glm-5.2, :verse 18, :comments ["<b>El pozo que cavaron los príncipes.</b> No estaba lleno, como es la naturaleza de uno que fluye desde un lugar alto." "<b>Y del desierto a Mattanah.</b> Con esto se explica que entregó su caudal desde aquella roca en el desierto."], :book "numbers", :voice :sforno, :lang :es, :chapter 21, :timestamp "2026-07-27T20:19:30.056411681Z", :translated-from :en, :model "glm-5.2"}