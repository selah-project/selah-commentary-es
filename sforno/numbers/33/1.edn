{:tier :glm-5.2, :verse 1, :comments ["<b>Estas son las jornadas.</b> El El, bendito sea, deseó que las jornadas de Israel fueran escritas, para dar a conocer su mérito en seguirlo por el desierto, en tierra no sembrada, de modo que fueran dignos de entrar en la tierra."], :book "numbers", :voice :sforno, :lang :es, :chapter 33, :timestamp "2026-07-27T20:20:21.737960981Z", :translated-from :en, :model "glm-5.2"}