{:tier :glm-5.2, :verse 9, :comments ["<b>Del fuego.</b> Pues está enteramente consagrado al Cielo, y los sacerdotes no tienen porción en él sino después de la quema de los fuegos, pues adquieren su porción de la mesa de lo alto — por lo tanto."], :book "numbers", :voice :sforno, :lang :es, :chapter 18, :timestamp "2026-07-27T20:19:20.025349572Z", :translated-from :en, :model "glm-5.2"}