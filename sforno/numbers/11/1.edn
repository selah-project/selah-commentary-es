{:tier :glm-5.2, :verse 1, :comments ["<b>Como quejumbrosos.</b> A causa de la dureza del camino. No murmuraron verdaderamente en sus corazones, pues no tenían un motivo digno de queja — pero se quejaron con sus palabras para ponerle a prueba."], :book "numbers", :voice :sforno, :lang :es, :chapter 11, :timestamp "2026-07-27T20:18:25.330420895Z", :translated-from :en, :model "glm-5.2"}