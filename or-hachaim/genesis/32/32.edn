{:tier :glm-5.2, :verse 32, :comments ["<b>Cuando pasaba por Penuel.</b> Quizás sea que el nombre del lugar no se llama Penuel sino solo según Iaacov, mientras que todos además de él — incluso el versículo de la Torá mismo — lo llaman Penuel, y así en efecto se llama en Jueces (8:8)."], :book "genesis", :voice :or-hachaim, :lang :es, :chapter 32, :timestamp "2026-07-27T17:51:47.626273063Z", :translated-from :en, :model "glm-5.2"}