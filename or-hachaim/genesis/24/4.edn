{:tier :glm-5.2, :verse 4, :comments ["<b>Porque a mi tierra, etc.</b> Esto también está incluido en el juramento, que debía tomar para sí una esposa de su tierra natal, y por eso se encuentra que inmediatamente y al instante tomó los camellos y fue a Aram Naharaim."], :book "genesis", :voice :or-hachaim, :lang :es, :chapter 24, :timestamp "2026-07-27T17:49:08.614020247Z", :translated-from :en, :model "glm-5.2"}