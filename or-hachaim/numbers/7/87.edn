{:tier :glm-5.2, :verse 87, :comments ["<b>Todo el ganado para la ofrenda de holocausto.</b> Usa una forma singular, para decir que hay una sola valla para todos ellos. Y asimismo dice <b>ganado del sacrificio de ofrendas de paz</b> en forma singular por esta misma razón."], :book "numbers", :voice :or-hachaim, :lang :es, :chapter 7, :timestamp "2026-07-27T18:06:46.266921542Z", :translated-from :en, :model "glm-5.2"}