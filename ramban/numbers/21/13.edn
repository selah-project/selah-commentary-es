{:tier :glm-5.2, :verse 13, :comments ["<b>Porque el Arnon es el límite de Moav, entre Moav y el amorreo</b> — Arnon era el nombre de una ciudad de Moav, y estaba en el extremo del territorio del amorreo, al comienzo del límite de Moav, situada sobre corrientes de agua que manaban de ella."], :book "numbers", :voice :ramban, :lang :es, :chapter 21, :timestamp "2026-07-27T14:45:32.197206217Z", :translated-from :en, :model "glm-5.2"}