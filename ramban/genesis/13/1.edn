{:tier :glm-5.2, :verse 1, :comments ["Y la razón de <b>él y su mujer y todo lo que tenía</b> es para informarnos que no le quitaron nada de todos los grandes regalos que le dieron a causa de Sará, para que ella fuera del rey, ni dijeron: 'Nos engañaste, y el regalo fue dado bajo falsos pretextos.' Y esto es un acto milagroso."], :book "genesis", :voice :ramban, :lang :es, :chapter 13, :timestamp "2026-07-27T14:24:12.293577277Z", :translated-from :en, :model "glm-5.2"}