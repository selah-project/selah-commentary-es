{:tier :glm-5.2, :verse 15, :comments ["Y el sentido de <b>ésta te herirá en el talón</b> es que el hombre tendrá ventaja sobre ti en la enemistad, pues él te herirá en la cabeza mientras que tú solo lo herirás en su talón, y él te aplastará el cerebro allí."], :book "genesis", :voice :ramban, :lang :es, :chapter 3, :timestamp "2026-07-27T14:22:15.374390206Z", :translated-from :en, :model "glm-5.2"}