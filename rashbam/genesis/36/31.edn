{:tier :glm-5.2, :verse 31, :comments ["Ante un rey — ante Moshé, que libró a Israel. Todo caudillo de un pueblo es llamado 'rey' hasta David. Encontré en Yosifón: después de estos reyes, cerca de cuarenta reyes nombrados por nombre, uno tras otro."], :book "genesis", :voice :rashbam, :lang :es, :chapter 36, :timestamp "2026-07-30T21:00:04.510964478Z", :translated-from :en, :model "glm-5.2"}