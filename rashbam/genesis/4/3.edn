{:tier :glm-5.2, :verse 3, :comments ["Una ofrenda — en el sentido de un regalo, derivado de נחה את העם. Es decir: si obras bien, al no cometer pecados excepto unos pocos, podrás soportar tus pecados y tus pecados no pesarán fuertemente sobre ti."], :book "genesis", :voice :rashbam, :lang :es, :chapter 4, :timestamp "2026-07-30T20:58:10.901290889Z", :translated-from :en, :model "glm-5.2"}