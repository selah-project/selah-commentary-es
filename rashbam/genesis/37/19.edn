{:tier :glm-5.2, :verse 19, :comments ["Este de aquí, ha-laze — cada ha-laze es cuando uno lo ve desde la distancia. Y asimismo: מי האיש הלזה — cel en francés antiguo; pero ha-zeh es cist en francés antiguo, como en: המן הרע הזה — cuando está cerca."], :book "genesis", :voice :rashbam, :lang :es, :chapter 37, :timestamp "2026-07-30T21:00:11.369972477Z", :translated-from :en, :model "glm-5.2"}