{:tier :glm-5.2, :verse 1, :comments ["Maskit — de שכה, como מרבית de רבה. Y no encuentro paralelo para ello excepto su contraparte עברו משכיות לבב — el lenguaje de 'reflejos del corazón'; así también aquí, una piedra que tiene imágenes y figuras en ella para contemplar."], :book "leviticus", :voice :rashbam, :lang :es, :chapter 26, :timestamp "2026-07-30T21:02:38.535086338Z", :translated-from :en, :model "glm-5.2"}