{:tier :glm-5.2, :verse 15, :comments ["איש איש כי יקלל אלהיו — enuncia la apelación de manera llana, sin especificar el Nombre explícito. Y especifica el Nombre explícito — bendito sea Su nombre — después: ונקב את שם יהוה."], :book "leviticus", :voice :rashbam, :lang :es, :chapter 24, :timestamp "2026-07-30T21:02:32.629257137Z", :translated-from :en, :model "glm-5.2"}