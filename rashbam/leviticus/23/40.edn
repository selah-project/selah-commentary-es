{:tier :glm-5.2, :verse 40, :comments ["Y una rama de un árbol frondoso — lleva un qamatz. Como קָדוֹשׁ, טָהוֹר, עָמוֹק, גָּדוֹל. Es decir: una rama de un árbol densamente espesado."], :book "leviticus", :voice :rashbam, :lang :es, :chapter 23, :timestamp "2026-07-30T21:02:31.169488847Z", :translated-from :en, :model "glm-5.2"}