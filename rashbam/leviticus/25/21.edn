{:tier :glm-5.2, :verse 21, :comments ["Por tres años — según el sentido llano: el producto del sexto año sostendrá al sexto y al séptimo. Y en el octavo plantarán y comerán del producto del sexto hasta el comienzo del noveno, cuando serán sostenidos del producto plantado en el octavo."], :book "leviticus", :voice :rashbam, :lang :es, :chapter 25, :timestamp "2026-07-30T21:02:36.169205276Z", :translated-from :en, :model "glm-5.2"}