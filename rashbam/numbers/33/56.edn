{:tier :glm-5.2, :verse 56, :comments ["Como pensé hacerles — yo tenía la intención de hacerles aquello que os mandé: ״לא תחיה כל נשמה״, pero vosotros los dejáis con vida y los dejáis vivir — así haré yo a vosotros, que no os dejaré vivir."], :book "numbers", :voice :rashbam, :lang :es, :chapter 33, :timestamp "2026-07-30T21:04:03.345747770Z", :translated-from :en, :model "glm-5.2"}