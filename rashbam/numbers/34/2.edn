{:tier :glm-5.2, :verse 2, :comments ["Esta es la tierra que os caerá en heredad — mi abuelo, nuestro Rabí, explicó y delimitó las fronteras, y aun así yo explicaré brevemente: el texto trazó primero la frontera del sur, luego la frontera del oeste, pues el Mar Grande es la frontera occidental, luego la del norte, y después la del este."], :book "numbers", :voice :rashbam, :lang :es, :chapter 34, :timestamp "2026-07-30T21:04:03.986389934Z", :translated-from :en, :model "glm-5.2"}