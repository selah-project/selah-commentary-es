{:tier :glm-5.2, :verse 16, :comments ["<b>Y él llevará su iniquidad.</b> Ella está coaccionada, pues supone que él puede anular, y ella no tenía obligación de aprender — pero él tenía obligación de aprender y no aprendió; por tanto, él mismo llevará su iniquidad."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 30, :timestamp "2026-07-30T20:00:18.763839765Z", :translated-from :en, :model "glm-5.2"}