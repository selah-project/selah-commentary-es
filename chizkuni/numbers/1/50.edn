{:tier :glm-5.2, :verse 50, :comments ["<b>Lo llevarán.</b> Cuando el campamento parta." "<b>Y servirán en él.</b> Cuando esté armado." "<b>Y alrededor del Mishkán acamparán.</b> Desde sus cuatro vientos en sus campamentos, para advertir y guardar, para que ningún extraño se acerque a él."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 1, :timestamp "2026-07-30T19:56:30.087332709Z", :translated-from :en, :model "glm-5.2"}