{:tier :glm-5.2, :verse 16, :comments ["<b>Y desde allí.</b> Desde la frontera de Moav — parte la advertencia de la prohibición, pues el viaje continuó hasta <b>el pozo</b>, que es el territorio santo de Edom, porque allí les dio el pozo."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 21, :timestamp "2026-07-30T19:59:08.151736756Z", :translated-from :en, :model "glm-5.2"}