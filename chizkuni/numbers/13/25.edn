{:tier :glm-5.2, :verse 25, :comments ["<b>Al cabo de cuarenta días.</b> Comenzaron el veintinueve de Siván, cuando fueron enviados los espías, y concluyeron el ocho de Ab al atardecer, pues completaron cuarenta días en Tamuz de aquel año, [y] los completaron."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 13, :timestamp "2026-07-30T19:58:01.044029888Z", :translated-from :en, :model "glm-5.2"}