{:tier :glm-5.2, :verse 28, :comments ["<b>Y ella es absuelta.</b> Del malestar abdominal." "<b>Y su simiente es sembrada.</b> La matriz no será dañada. Otra interpretación: <b>y su simiente es sembrada</b> — su marido puede llegar a ella en relación de simiente a partir de este momento con permiso."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 5, :timestamp "2026-07-30T19:56:57.538599223Z", :translated-from :en, :model "glm-5.2"}