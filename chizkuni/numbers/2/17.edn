{:tier :glm-5.2, :verse 17, :comments ["<b>Y el Tabernáculo de Reunión partirá.</b> Lo que está escrito, ״וארון ברית ה׳ נוסע לפניהם״ — ese es el arca que hizo Moshé, en la cual se colocan los fragmentos de las tablillas, y es la que sale con ellos a la guerra."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 2, :timestamp "2026-07-30T19:56:33.891324040Z", :translated-from :en, :model "glm-5.2"}