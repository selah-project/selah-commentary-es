{:tier :glm-5.2, :verse 30, :comments ["<b>Y un solo testigo no testificará en un caso capital.</b> Dado que el castigo en los casos capitales es severo, un solo testigo es creído en ellos — esto es lo que dice."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 35, :timestamp "2026-07-30T20:00:47.308904227Z", :translated-from :en, :model "glm-5.2"}