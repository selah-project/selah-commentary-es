{:tier :glm-5.2, :verse 12, :comments ["<b>Todos los utensilios de servicio.</b> Cuchillos, cuencos, copas." "<b>Y los colocarán sobre el palo.</b> Como es la práctica para toda carga que se lleva en un palo, y no debajo del palo, no sea que la carga se arrastre por el suelo."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 4, :timestamp "2026-07-30T19:56:44.560638847Z", :translated-from :en, :model "glm-5.2"}