{:tier :glm-5.2, :verse 47, :comments ["<b>Para servir el servicio del servicio.</b> El desmontaje y erección del Tabernáculo, que recae igualmente sobre todos los levitas." "<b>Y el servicio de llevar.</b> El Arca, la Mesa, la Menorá y los Altares, que los hijos de Kehat transportan."], :book "numbers", :voice :chizkuni, :lang :es, :chapter 4, :timestamp "2026-07-30T19:56:48.184496950Z", :translated-from :en, :model "glm-5.2"}