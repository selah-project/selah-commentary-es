{:tier :glm-5.2, :verse 11, :comments ["<b>Es una erupción antigua.</b> Esta es una lesión antigua, y se ha curado por encima, y por debajo está llena de fluido — para que no digas: puesto que ha comenzado a sanar, la declararé pura."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 13, :timestamp "2026-07-30T19:53:47.726506069Z", :translated-from :en, :model "glm-5.2"}