{:tier :glm-5.2, :verse 8, :comments ["<b>De su carne no comeréis.</b> De los degollados entre ellos — pues en todo caso no salen de la categoría de nevelah." "<b>Y en su nevelah.</b> De los que murieron por sí mismos." "<b>[No tocaréis.</b> Para comerlos]."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 11, :timestamp "2026-07-30T19:53:27.854124072Z", :translated-from :en, :model "glm-5.2"}