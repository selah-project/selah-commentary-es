{:tier :glm-5.2, :verse 31, :comments ["<b>Todos los que los toquen.</b> El cadáver de un reptil que se arrastra transmite impureza a partir del tamaño de una lenteja, pues una lagartija al comienzo de su formación es del tamaño de una lenteja."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 11, :timestamp "2026-07-30T19:53:34.600444542Z", :translated-from :en, :model "glm-5.2"}