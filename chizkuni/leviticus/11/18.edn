{:tier :glm-5.2, :verse 18, :comments ["<b>El tinshemet.</b> En antiguo francés, chourette — todo el que lo ve se asombra." "<b>El kaat.</b> Su nombre no se explica; su costumbre es vomitar su comida." "<b>El racham.</b> En antiguo francés, pia — tiene compasión de sus crías."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 11, :timestamp "2026-07-30T19:53:31.209130876Z", :translated-from :en, :model "glm-5.2"}