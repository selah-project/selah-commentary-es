{:tier :glm-5.2, :verse 28, :comments ["<b>Y una laceración.</b> Para hacerlo responsable por cada una de cinco laceraciones, incluso si las causó todas a la vez." "<b>Por una vida.</b> Específicamente por un cadáver — esto excluye su casa que se derrumbó y su barco que se hundió en el mar."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 19, :timestamp "2026-07-30T19:54:53.170416241Z", :translated-from :en, :model "glm-5.2"}