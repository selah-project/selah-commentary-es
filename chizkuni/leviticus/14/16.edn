{:tier :glm-5.2, :verse 16, :comments ["<b>Y el sacerdote mojará, del aceite.</b> מן en lugar de la letra bet." "<b>Y mojará y rociará.</b> Por cada rociamiento, una inmersión." "<b>Su lado derecho.</b> El lugar que se ve, es decir, el lado derecho del rostro."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 14, :timestamp "2026-07-30T19:54:05.134522684Z", :translated-from :en, :model "glm-5.2"}