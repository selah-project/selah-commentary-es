{:tier :glm-5.2, :verse 31, :comments ["<b>Pero las casas de los patios.</b> Porque a veces una persona la convierte en un campo, por tanto es considerada como el campo de la tierra — ya que son como un campo, es decir, su redención será suya, y en el Yovel sale."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 25, :timestamp "2026-07-30T19:55:54.986686457Z", :translated-from :en, :model "glm-5.2"}