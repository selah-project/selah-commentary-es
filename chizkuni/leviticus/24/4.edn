{:tier :glm-5.2, :verse 4, :comments ["<b>Sobre la menorá pura.</b> Sobre la pureza de la menorá — que no ha de disponerlas con mechas y nudos." "<b>Delante de HaShem.</b> Que no ha de prepararla fuera y luego llevarla adentro."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 24, :timestamp "2026-07-30T19:55:37.477390027Z", :translated-from :en, :model "glm-5.2"}