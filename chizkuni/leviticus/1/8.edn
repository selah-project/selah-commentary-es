{:tier :glm-5.2, :verse 8, :comments ["<b>Y ellos dispondrán, los hijos de Aharón.</b> Respecto al ganado mayor, que es un animal grande, escribe וערכו (y ellos dispondrán); pero respecto a las ovejas, que son un animal pequeño, escribe וערך (y él dispondrá)."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 1, :timestamp "2026-07-30T19:52:22.396557997Z", :translated-from :en, :model "glm-5.2"}