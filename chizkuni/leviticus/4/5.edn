{:tier :glm-5.2, :verse 5, :comments ["<b>Y el sacerdote ungido tomará de la sangre.</b> Tomar se menciona aquí, y tomar se menciona más abajo — así como más abajo, el tomar es en un recipiente, también aquí, el tomar es en un recipiente."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 4, :timestamp "2026-07-30T19:52:37.774163226Z", :translated-from :en, :model "glm-5.2"}