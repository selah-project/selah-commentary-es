{:tier :glm-5.2, :verse 35, :comments ["<b>Todos los días de su desolación.</b> Que esté desolada y vaciada de ustedes." "<b>תשבת</b> Con cholam, por el acento disyuntivo, como הים ראה וינוס אשר ימות בה הכהו וימות."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 26, :timestamp "2026-07-30T19:56:12.613316084Z", :translated-from :en, :model "glm-5.2"}