{:tier :glm-5.2, :verse 3, :comments ["<b>Si en Mis estatutos camináis.</b> Si hacéis lo que os he impuesto hacer, entonces las nubes y la tierra y los árboles, que fueron creados por vuestro motivo, harán por vosotros lo que les incumbe hacer."], :book "leviticus", :voice :chizkuni, :lang :es, :chapter 26, :timestamp "2026-07-30T19:56:00.709023503Z", :translated-from :en, :model "glm-5.2"}