{:tier :glm-5.2, :verse 49, :comments ["<b>Una sola torá habrá.</b> Lenguaje masculino respecto a un sujeto femenino en varios pasajes." "<b>El forastero que reside entre vosotros.</b> Y no 'el forastero en la puerta' — ese es un 'forastero de la puerta'."], :book "exodus", :voice :chizkuni, :lang :es, :chapter 12, :timestamp "2026-07-30T19:41:14.230589278Z", :translated-from :en, :model "glm-5.2"}