{:tier :glm-5.2, :verse 8, :comments ["<b>Hagar, sierva de Sarai.</b> No como supones que eres su señora — pues todavía eres una sierva. Y ella le reconoció, por consideración a Sarai: 'mi señora — de ella huí.'"], :book "genesis", :voice :chizkuni, :lang :es, :chapter 16, :timestamp "2026-07-30T19:47:32.018635174Z", :translated-from :en, :model "glm-5.2"}