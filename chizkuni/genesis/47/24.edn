{:tier :glm-5.2, :verse 24, :comments ["<b>Y darás un quinto a Faraón.</b> Porque será de cinco se'ah: uno para <b>semilla</b> de la tierra, el segundo <b>para vuestro comer,</b> el tercero <b>para los de vuestras casas</b> — para vuestros siervos y siervas, el cuarto para vuestros hijos, y el quinto para Faraón."], :book "genesis", :voice :chizkuni, :lang :es, :chapter 47, :timestamp "2026-07-30T19:51:48.902763225Z", :translated-from :en, :model "glm-5.2"}