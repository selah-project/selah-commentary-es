{:tier :glm-5.2, :verse 18, :comments ["<b>No es bueno, el ser del hombre solo.</b> Al principio surgió en el pensamiento hacerle una compañera, pero no se encontró ocasión para hacerlo sino hasta después de poner nombre a los animales, para que él la deseara y la estimara más."], :book "genesis", :voice :chizkuni, :lang :es, :chapter 2, :timestamp "2026-07-30T19:45:43.658271908Z", :translated-from :en, :model "glm-5.2"}