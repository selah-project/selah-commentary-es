{:tier :glm-5.2, :verse 12, :comments ["<b>Y traeré sobre mí una maldición y no una bendición.</b> Por tanto, [no] le digo: 'Yo soy Esav' — porque aun así no me creería. Y si me palpa, me reconocerá y me maldecirá, porque le mentí."], :book "genesis", :voice :chizkuni, :lang :es, :chapter 27, :timestamp "2026-07-30T19:49:14.846903211Z", :translated-from :en, :model "glm-5.2"}