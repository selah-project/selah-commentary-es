{:tier :glm-5.2, :verse 20, :comments ["<b>Yizbeleni ishi.</b> Yizbol imi, como בני יצאוני גדוד יגודנו — formas que funcionan como dos. Otra interpretación: él debe hacerme una morada a mí y a mis hijos, pues le he dado seis hijos."], :book "genesis", :voice :chizkuni, :lang :es, :chapter 30, :timestamp "2026-07-30T19:49:43.871966079Z", :translated-from :en, :model "glm-5.2"}