{:tier :glm-5.2, :verse 3, :comments ["<b>Para piedra.</b> La lamed lleva un sheva bajo la bet." "<b>Y el chemar fue para ellos por chemar.</b> Lo untaron con brea, para que el agua no pueda disolverlo. A la brea la llama chemar."], :book "genesis", :voice :chizkuni, :lang :es, :chapter 11, :timestamp "2026-07-30T19:46:58.127451362Z", :translated-from :en, :model "glm-5.2"}