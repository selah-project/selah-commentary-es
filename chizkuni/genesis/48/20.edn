{:tier :glm-5.2, :verse 20, :comments ["<b>Y los puso</b> en su bendición <b>a Efraim antes que a Menasheh</b> — porque dijo: «Que Elohim te haga como Efraim y como Menasheh.» Y también más arriba dijo: «Efraim y Menasheh serán para mí como Reuvén y Shimón.»"], :book "genesis", :voice :chizkuni, :lang :es, :chapter 48, :timestamp "2026-07-30T19:51:58.637053071Z", :translated-from :en, :model "glm-5.2"}