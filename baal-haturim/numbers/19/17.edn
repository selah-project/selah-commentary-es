{:tier :glm-5.2, :verse 17, :comments ["<b>אל כלי</b> Dos veces en la Masorá: «y pondrá sobre ella agua viva אל כלי» y la otra «y no vertida de כלי אל כלי» — porque su vitalidad debe estar en un כלי y no que uno los vierta de כלי אל כלי."], :book "numbers", :voice :baal-haturim, :lang :es, :chapter 19, :timestamp "2026-07-27T13:12:56.146538955Z", :translated-from :en, :model "glm-5.2"}