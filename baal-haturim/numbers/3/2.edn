{:tier :glm-5.2, :verse 2, :comments ["<b>Aharón el primogénito, Nadav</b> — hay una marca de puntuación entre \"el primogénito\" y \"Nadav,\" para enseñar que no se refiere a Nadav, porque Nadav murió sin hijos y su condición de primogénito no tiene consecuencia práctica, sino que se refiere a Aharón, quien es el primogénito ante Moshé:"], :book "numbers", :voice :baal-haturim, :lang :es, :chapter 3, :timestamp "2026-07-27T13:10:54.353585432Z", :translated-from :en, :model "glm-5.2"}