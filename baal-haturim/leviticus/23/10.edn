{:tier :glm-5.2, :verse 10, :comments ["<b>קצירה</b> — dos veces: וקצרתם את קצירה, ביבוש, קצירה. Pues si traen el ómer — וקצרתם את קצירה; y si no — ביבש, קצירה."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 23, :timestamp "2026-07-27T13:10:05.062892978Z", :translated-from :en, :model "glm-5.2"}