{:tier :glm-5.2, :verse 1, :comments ["<b>ופסל</b> — la alef está doblada/torcida, diciéndole: ¡vete! Pues quien niega la idolatría es como si afirmara toda la Torá, que fue dada de los besos de Su boca, por así decirlo, de HaShem."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 26, :timestamp "2026-07-27T13:10:28.859730408Z", :translated-from :en, :model "glm-5.2"}