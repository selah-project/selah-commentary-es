{:tier :glm-5.2, :verse 3, :comments ["<b>ואני אתן</b> — bet. Un asunto, y el otro: ואני אתן את שכרך — que si se arrepiente, ואני אתן שכרך — sus pecados se le reckonen como méritos:"], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 20, :timestamp "2026-07-27T13:09:44.154968004Z", :translated-from :en, :model "glm-5.2"}