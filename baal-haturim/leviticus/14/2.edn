{:tier :glm-5.2, :verse 2, :comments ["<b>Esta será la ley del metzorá</b> — dos aves, en correspondencia con 'Como el ave que vaga lejos de su nido, así es el hombre que vaga de su lugar', pues de él está escrito 'habitará solo'; por tanto, su purificación es mediante aves."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 14, :timestamp "2026-07-27T13:08:58.454717143Z", :translated-from :en, :model "glm-5.2"}