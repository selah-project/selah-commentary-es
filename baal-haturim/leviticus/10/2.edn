{:tier :glm-5.2, :verse 2, :comments ["<b>Y los consumió</b> — אותם en guematria es זה הנפש. אותם está escrito plene con vav; pecaron en seis cosas: fuego extraño; gobernaron en presencia de su señor; intoxicados con vino; no tuvieron hijos; pusieron sus ojos en el sustento; no pidieron consejo."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 10, :timestamp "2026-07-27T13:08:25.327113992Z", :translated-from :en, :model "glm-5.2"}