{:tier :glm-5.2, :verse 3, :comments ["<b>וידום</b> — dos veces: וידום אהרן y וידום השמש. Alusión a lo que dijeron: los luminares son heridos a causa de un av bet din que ha muerto, y los hijos de Aarón eran av bet din."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 10, :timestamp "2026-07-27T13:08:25.208784975Z", :translated-from :en, :model "glm-5.2"}