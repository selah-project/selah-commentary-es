{:tier :glm-5.2, :verse 8, :comments ["<b>Son abominación para vosotros</b> — y junto a ello: 'estos podéis comer' — una alusión a que el vino del mar está permitido. No mencionó nombres para los peces porque están ocultos a los hombres; no tienen nombres."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 11, :timestamp "2026-07-27T13:08:36.322329395Z", :translated-from :en, :model "glm-5.2"}