{:tier :glm-5.2, :verse 1, :comments ["<b>Si no lo declara, y lleva su iniquidad</b> — אם לוא יגיד está escrito plene con vav; léese como אם לו יגיד con un vav, en el sentido de: si ya se lo ha declarado, ya no repite y lo declara."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 5, :timestamp "2026-07-27T13:08:08.367570154Z", :translated-from :en, :model "glm-5.2"}