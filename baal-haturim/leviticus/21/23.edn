{:tier :glm-5.2, :verse 23, :comments ["<b>Solo hasta el parójet no vendrá</b> — אך es una restricción, que a veces puede entrar, como en lo que decimos: si no entran sacerdotes, levitas; si no entran puros, impuros; si no entran impuros, aquellos con defectos."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 21, :timestamp "2026-07-27T13:09:53.329716056Z", :translated-from :en, :model "glm-5.2"}