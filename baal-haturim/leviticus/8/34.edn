{:tier :glm-5.2, :verse 34, :comments ["<b>לעשת</b> es defectiva (le falta el vav), pues decimos en el capítulo 1 de Yoma: לעשת — este es el rito de la parah (vaca roja), pues rociarían sobre él todos los seis días y no rociarían sobre él en Shabat."], :book "leviticus", :voice :baal-haturim, :lang :es, :chapter 8, :timestamp "2026-07-27T13:08:17.962924739Z", :translated-from :en, :model "glm-5.2"}