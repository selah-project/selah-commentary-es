{:tier :glm-5.2, :verse 16, :comments ["<b>ספר</b> Dos veces en la Masorá: aquí y la otra, הזכירני נשפטה יחד ספר אתה למען תצדק. Cuando HaShem ejecuta juicio sobre los impíos, Su nombre es exaltado — esto es נשפטה יחד ספר שמי בכל הארץ, que Su nombre es exaltado por ello."], :book "exodus", :voice :baal-haturim, :lang :es, :chapter 9, :timestamp "2026-07-27T12:57:37.430697589Z", :translated-from :en, :model "glm-5.2"}