{:tier :glm-5.2, :verse 20, :comments ["<b>ויטע</b> Tres veces en la Masorah: ויטע כרם. ויטע ה' אלהים גן בעדן. ויטע אשל. Nuestros Sabios expusieron: ¿de dónde tomó el esqueje? Del Jardín del Edén. Y de igual manera Avraham tomó el אשל del Jardín del Edén."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 9, :timestamp "2026-07-27T13:02:36.692944395Z", :translated-from :en, :model "glm-5.2"}