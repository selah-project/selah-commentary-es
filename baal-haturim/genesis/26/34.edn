{:tier :glm-5.2, :verse 34, :comments ["<b>Beeri</b> Dos veces en la Masorá: aquí, בת בארי החתי. Y la otra: הושע בן בארי. Pues Oseas dijo ante el Santo, bendito sea Él: Él los cambió por otra nación mediante la descendencia de Esaú."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 26, :timestamp "2026-07-27T13:04:21.850777933Z", :translated-from :en, :model "glm-5.2"}