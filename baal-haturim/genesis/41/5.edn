{:tier :glm-5.2, :verse 5, :comments ["<b>בקנה אחד</b> Tres veces en la Masorá: aquí dos veces, y la tercera junto a la Menorá. Pues aquel que jura es luz para el mundo, y por eso vio a las sanas en una sola caña y a las marchitas no las vio en una sola caña."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 41, :timestamp "2026-07-27T13:06:25.938323032Z", :translated-from :en, :model "glm-5.2"}