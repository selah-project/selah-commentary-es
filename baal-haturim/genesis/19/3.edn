{:tier :glm-5.2, :verse 3, :comments ["<b>Y preparó panes sin levadura</b> — Dos veces en la Masorá: esta y la otra: 'asados al fuego y panes sin levadura', enseñando que era Pésaj. Pues aprendemos el asunto de los matzot de aquí a partir de los matzot de allá."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 19, :timestamp "2026-07-27T13:03:18.445627155Z", :translated-from :en, :model "glm-5.2"}