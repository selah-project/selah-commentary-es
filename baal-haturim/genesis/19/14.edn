{:tier :glm-5.2, :verse 14, :comments ["<b>Levantaos, salid de este lugar</b> — dos veces en la Masorá: aquí y el otro <b>קומו צאו מתוך עמי</b>. Enseña que Israel se dividió en facciones — algunos que no querían salir y murieron en los tres días de oscuridad."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 19, :timestamp "2026-07-27T13:03:20.102854778Z", :translated-from :en, :model "glm-5.2"}