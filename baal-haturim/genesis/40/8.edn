{:tier :glm-5.2, :verse 8, :comments ["<b>ספרו</b> — Tres veces en la Masorá: aquí, y las otras: ספרו בגוים את כבודו — una en Salmos y una en Crónicas. Respecto del relato que contaron — ספרו בגוים — la gloria de Yosef, que lo alabaron delante de Faraón."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 40, :timestamp "2026-07-27T13:06:19.615301671Z", :translated-from :en, :model "glm-5.2"}