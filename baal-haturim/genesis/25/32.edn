{:tier :glm-5.2, :verse 32, :comments ["<b>Y ¿por qué esto</b> — dos veces en la Masorá con guion. La otra: ולמה זה הבל תהבלו (\"¿y por qué esto — tratarías con falsedad?\"). Enseña que él negó el principio fundamental y fue tras הבל (futilidad)."], :book "genesis", :voice :baal-haturim, :lang :es, :chapter 25, :timestamp "2026-07-27T13:04:12.098278772Z", :translated-from :en, :model "glm-5.2"}