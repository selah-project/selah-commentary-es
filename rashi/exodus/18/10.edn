{:tier :glm-5.2, :verse 10, :comments ["<b>Quien te libró de la mano de Egipto.</b> Una nación dura." "<b>Y de la mano de Faraón.</b> Un rey duro." "<b>De bajo la mano de Egipto.</b> Como lo traduce el Targum — un término de sometimiento y dominación; la 'mano' con la que los agobiaba es el trabajo."], :book "exodus", :voice :rashi, :lang :es, :chapter 18, :timestamp "2026-08-02T09:22:55.431831443Z", :translated-from :en, :model "glm-5.2"}