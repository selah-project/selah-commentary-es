{:tier :glm-5.2, :verse 12, :comments ["<b>Sobre los cuernos.</b> Literalmente encima, sobre los cuernos." "<b>Y toda la sangre.</b> El resto de la sangre." "<b>A la base del altar.</b> Una especie de borde saliente hecho para él todo alrededor, después de que se eleva un codo del suelo."], :book "exodus", :voice :rashi, :lang :es, :chapter 29, :timestamp "2026-08-02T09:25:47.481047509Z", :translated-from :en, :model "glm-5.2"}