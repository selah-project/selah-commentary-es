{:tier :glm-5.2, :verse 17, :comments ["<b>Y Señor de señores.</b> Ningún señor puede salvarte de Su mano." "<b>Y no hace acepción de personas.</b> Si te quitas de encima Su yugo." "<b>Y no acepta soborno.</b> Para apaciguarlo con dinero."], :book "deuteronomy", :voice :rashi, :lang :es, :chapter 10, :timestamp "2026-08-02T09:15:19.366283032Z", :translated-from :en, :model "glm-5.2"}