{:tier :glm-5.2, :verse 2, :comments ["<b>Al acercarte a la batalla.</b> Cerca de tu salida de la frontera — del límite de tu tierra." "<b>Y se acercará el sacerdote.</b> El ungido para esto — y es el que se llama 'el ungido para la batalla'." "<b>Y hablará al pueblo.</b> En la lengua sagrada (Sotah 42)."], :book "deuteronomy", :voice :rashi, :lang :es, :chapter 20, :timestamp "2026-08-02T09:16:53.226987134Z", :translated-from :en, :model "glm-5.2"}