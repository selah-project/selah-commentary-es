{:tier :glm-5.2, :verse 13, :comments ["<b>Y por Su nombre jurarás.</b> Si posees todas estas cualidades — que temes Su nombre y Le sirves — entonces puedes jurar por Su nombre; pues por tu temor a Su nombre serás cuidadoso con tu juramento. Y si no — no jures."], :book "deuteronomy", :voice :rashi, :lang :es, :chapter 6, :timestamp "2026-08-02T09:14:59.624621845Z", :translated-from :en, :model "glm-5.2"}