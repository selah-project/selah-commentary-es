{:tier :glm-5.2, :verse 53, :comments ["<b>Y desposeeréis la tierra.</b> La desposeeréis de sus habitantes, y entonces <b>y habitaréis en ella</b> — podréis permanecer en ella; y si no, no podréis permanecer en ella."], :book "numbers", :voice :rashi, :lang :es, :chapter 33, :timestamp "2026-08-02T09:47:12.843116119Z", :translated-from :en, :model "glm-5.2"}