{:tier :glm-5.2, :verse 25, :comments ["<b>Las cortinas del Tabernáculo.</b> Las diez cortinas inferiores." "<b>Y la Tienda de Reunión.</b> Las cortinas de pieles de cabra hechas como tienda sobre ella." "<b>Su cubierta.</b> Las pieles de carnero teñidas de rojo." "<b>La cortina de la entrada.</b> La cortina oriental."], :book "numbers", :voice :rashi, :lang :es, :chapter 4, :timestamp "2026-08-02T09:42:21.130304564Z", :translated-from :en, :model "glm-5.2"}