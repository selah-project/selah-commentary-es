{:tier :glm-5.2, :verse 15, :comments ["<b>Para cubrir las cosas sagradas.</b> El Arca y el Altar." "<b>Y todos los utensilios sagrados.</b> La Menorá y sus utensilios de servicio." "<b>Y morirán.</b> Pues si tocan — son acreedores a muerte a manos del Cielo."], :book "numbers", :voice :rashi, :lang :es, :chapter 4, :timestamp "2026-08-02T09:42:19.781779292Z", :translated-from :en, :model "glm-5.2"}