{:tier :glm-5.2, :verse 29, :comments ["<b>¡Ay de ti, Moab!</b> Porque maldijeron a Moab para que fuera entregado en su mano (Tanjuma)." "<b>Chemosh.</b> El nombre del dios de Moab." "<b>Él dio.</b> El que da a los hijos de Moab." "<b>Sus sobrevivientes</b> — fugitivos y escapados de la espada, y sus hijas a la cautividad, etc."], :book "numbers", :voice :rashi, :lang :es, :chapter 21, :timestamp "2026-08-02T09:45:21.821869783Z", :translated-from :en, :model "glm-5.2"}