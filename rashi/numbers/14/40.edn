{:tier :glm-5.2, :verse 40, :comments ["<b>Hasta la cumbre del monte.</b> Es decir, el camino que sube hacia la tierra de Israel." "<b>Aquí estamos, y subiremos al lugar.</b> A la tierra de Israel." "<b>Del cual habló YHWH.</b> Para dárnosla — hasta allí subiremos." "<b>Porque hemos pecado.</b> En que dijimos: «¿No es mejor para nosotros volver a Egipto?»"], :book "numbers", :voice :rashi, :lang :es, :chapter 14, :timestamp "2026-08-02T09:44:09.263375809Z", :translated-from :en, :model "glm-5.2"}