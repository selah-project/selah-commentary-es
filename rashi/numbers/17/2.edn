{:tier :glm-5.2, :verse 2, :comments ["<b>Y el fuego.</b> Estaba dentro de las paletas." "<b>Esparcir lejos.</b> Sobre el suelo, fuera de las paletas." "<b>Porque se han sagrado.</b> Las paletas están prohibidas para beneficio, pues fueron convertidas en utensilios de servicio."], :book "numbers", :voice :rashi, :lang :es, :chapter 17, :timestamp "2026-08-02T09:44:35.544851316Z", :translated-from :en, :model "glm-5.2"}