{:tier :glm-5.2, :verse 25, :comments ["<b>El mishkán.</b> Las cortinas inferiores." "<b>Y la ohel.</b> Las cortinas de pelo de cabra hechas para techo." "<b>Su cubierta.</b> Pieles de carnero y pieles de tachash." "<b>Y la cortina de la entrada.</b> Es decir, el vilón."], :book "numbers", :voice :rashi, :lang :es, :chapter 3, :timestamp "2026-08-02T09:42:09.730665638Z", :translated-from :en, :model "glm-5.2"}