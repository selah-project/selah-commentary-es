{:tier :glm-5.2, :verse 15, :comments ["<b>Hacia el oriente, al este.</b> Hacia el frente del mundo — pues ellos están en el este, ya que el viento del este es llamado 'frente' y el viento del oeste es llamado 'detrás'; por lo tanto, el sur está a la derecha y el norte a la izquierda."], :book "numbers", :voice :rashi, :lang :es, :chapter 34, :timestamp "2026-08-02T09:47:18.820703196Z", :translated-from :en, :model "glm-5.2"}