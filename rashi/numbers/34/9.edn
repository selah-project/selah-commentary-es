{:tier :glm-5.2, :verse 9, :comments ["<b>Y su salida será Hatzar-Enán.</b> Era el final del límite norte, por lo que Hatzar-Enán se encuentra en la esquina noreste. Desde allí <b>les señalaréis</b> hacia el límite oriental."], :book "numbers", :voice :rashi, :lang :es, :chapter 34, :timestamp "2026-08-02T09:47:17.540018081Z", :translated-from :en, :model "glm-5.2"}