{:tier :glm-5.2, :verse 7, :comments ["<b>Y su ofrenda de libación.</b> Vino." "<b>En el lugar santo derrámalo.</b> Sobre el altar se derraman." "<b>La ofrenda de libación de bebida fuerte.</b> Vino que intoxica — excluyendo el vino recién salido del lagar (Bava Batra 97)."], :book "numbers", :voice :rashi, :lang :es, :chapter 28, :timestamp "2026-08-02T09:46:31.932775494Z", :translated-from :en, :model "glm-5.2"}