{:tier :glm-5.2, :verse 17, :comments ["<b>Maldita sea la tierra por tu causa.</b> Hace brotar contra ti cosas malditas — tales como moscas, pulgas y hormigas. Una parábola: uno que sale a un mercado malo y la gente maldice los pechos de los que mamó."], :book "genesis", :voice :rashi, :lang :es, :chapter 3, :timestamp "2026-08-02T09:28:04.053514508Z", :translated-from :en, :model "glm-5.2"}