{:tier :glm-5.2, :verse 2, :comments ["<b>En lugar de.</b> ¿Acaso estoy yo entonces en Su lugar?" "<b>¿Quién te ha privado.</b> Dices que yo debería hacer como hizo mi padre — yo no soy como mi padre. Mi padre no tenía hijos; yo tengo hijos. De ti Él privó, no de mí."], :book "genesis", :voice :rashi, :lang :es, :chapter 30, :timestamp "2026-08-02T09:32:18.454278335Z", :translated-from :en, :model "glm-5.2"}