{:tier :glm-5.2, :verse 34, :comments ["<b>Porciones.</b> Porciones." "<b>Cinco porciones.</b> Su porción con sus hermanos, y la porción de Yosef y de Osnat y de Menashe y de Efráyim." "<b>Y bebieron con él.</b> Desde el día en que lo vendieron no bebieron vino, tampoco él bebió vino — y aquel día bebieron (Bereshit Rabá)."], :book "genesis", :voice :rashi, :lang :es, :chapter 43, :timestamp "2026-08-02T09:35:04.231447823Z", :translated-from :en, :model "glm-5.2"}