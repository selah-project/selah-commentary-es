{:tier :glm-5.2, :verse 1, :comments ["<b>Queturá.</b> Esta es Hagar. Fue llamada Queturá porque sus obras eran agradables como el incienso (Bereshit Rabbah), y porque cerró su apertura — no tuvo intimidad con ningún hombre desde el día en que se separó de Avraham."], :book "genesis", :voice :rashi, :lang :es, :chapter 25, :timestamp "2026-08-02T09:31:25.471187971Z", :translated-from :en, :model "glm-5.2"}