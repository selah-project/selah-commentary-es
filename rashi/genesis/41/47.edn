{:tier :glm-5.2, :verse 47, :comments ["<b>Y la tierra produjo.</b> Como lo traduce el Targum — y la expresión no está desarraigada del lenguaje de hacer." "<b>En almacenes.</b> Puñado sobre puñado, mano sobre mano — los iban acumulando."], :book "genesis", :voice :rashi, :lang :es, :chapter 41, :timestamp "2026-08-02T09:34:32.302559308Z", :translated-from :en, :model "glm-5.2"}