{:tier :glm-5.2, :verse 17, :comments ["<b>Partieron de aquí.</b> Se alejaron de la hermandad." "<b>Vamos, te ruego, a Dotán.</b> Para buscarte motivos de muerte, y así poder matarte por ellos. Y según su sentido simple es un nombre de lugar — y la Escritura no se aparta de su sentido simple."], :book "genesis", :voice :rashi, :lang :es, :chapter 37, :timestamp "2026-08-02T09:33:49.914679480Z", :translated-from :en, :model "glm-5.2"}