{:tier :glm-5.2, :verse 18, :comments ["<b>En el segundo año.</b> De los años de hambre." "<b>Porque si el dinero se ha acabado, etc.</b> Pues cuando el dinero y el ganado se hayan acabado y todo haya llegado a la mano de mi señor —" "<b>Excepto nuestros cuerpos.</b> Como 'si no fuera por nuestros cuerpos.'"], :book "genesis", :voice :rashi, :lang :es, :chapter 47, :timestamp "2026-08-02T09:35:31.617014580Z", :translated-from :en, :model "glm-5.2"}