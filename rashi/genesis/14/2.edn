{:tier :glm-5.2, :verse 2, :comments ["<b>Bera.</b> Impío para con el cielo e impío para con las criaturas." "<b>Birsha.</b> Creció en impiedad con maldad." "<b>Shinab.</b> Aborrecedor de su Padre en el cielo." "<b>Shemeber.</b> Se puso alas para volar y para saltar y para rebelarse contra el Santo, bendito sea." "<b>Bela.</b> Nombre de la ciudad."], :book "genesis", :voice :rashi, :lang :es, :chapter 14, :timestamp "2026-08-02T09:29:22.715268419Z", :translated-from :en, :model "glm-5.2"}