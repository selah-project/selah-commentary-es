{:tier :glm-5.2, :verse 5, :comments ["<b>Y en el año decimocuarto.</b> Por la rebelión." "<b>Cedorlaomer vino.</b> Porque él era el ideólogo de la campaña, entra en lo grueso de la viga." "<b>Y los reyes.</b> Estos son tres reyes." "<b>Los Zuzim.</b> Estos son los Zamzumim."], :book "genesis", :voice :rashi, :lang :es, :chapter 14, :timestamp "2026-08-02T09:29:22.625637540Z", :translated-from :en, :model "glm-5.2"}