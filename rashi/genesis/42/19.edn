{:tier :glm-5.2, :verse 19, :comments ["<b>A la casa de su encierro.</b> Que ahora están encerrados en ella." "<b>Y tú, ve, lleva.</b> A la casa de tu padre." "<b>Comprad alimento para vuestras casas.</b> Lo que habéis comprado para aliviar el hambre de la gente de vuestras casas."], :book "genesis", :voice :rashi, :lang :es, :chapter 42, :timestamp "2026-08-02T09:34:43.424574323Z", :translated-from :en, :model "glm-5.2"}