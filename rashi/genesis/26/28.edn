{:tier :glm-5.2, :verse 28, :comments ["<b>Viendo, hemos visto.</b> Vimos en tu padre; vemos en ti." "<b>Sea ahora un juramento entre nosotros, etc.</b> El juramento que hubo entre nosotros desde los días de tu padre — que sea también ahora <b>entre nosotros y tú</b>."], :book "genesis", :voice :rashi, :lang :es, :chapter 26, :timestamp "2026-08-02T09:31:45.649494648Z", :translated-from :en, :model "glm-5.2"}