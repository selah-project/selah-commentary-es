{:tier :glm-5.2, :verse 15, :comments ["<b>No llamarás su nombre Sarai.</b> Pues el significado de <b>ש · ר · י</b> es «para mí», y no para otros. <b>Sino Sarah</b> — su nombre es absoluto: que ella será princesa sobre todos (Berajot 13)."], :book "genesis", :voice :rashi, :lang :es, :chapter 17, :timestamp "2026-08-02T09:29:54.648177806Z", :translated-from :en, :model "glm-5.2"}