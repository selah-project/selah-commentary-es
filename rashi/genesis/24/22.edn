{:tier :glm-5.2, :verse 22, :comments ["<b>Un beka.</b> Una alusión a los shekels de Israel — un beka por cabeza." "<b>Y dos pulseras.</b> Una alusión a las dos tablas, unidas entre sí." "<b>Diez de oro, su peso.</b> Una alusión a los Diez Mandamientos, que están en ellas."], :book "genesis", :voice :rashi, :lang :es, :chapter 24, :timestamp "2026-08-02T09:31:14.052062798Z", :translated-from :en, :model "glm-5.2"}