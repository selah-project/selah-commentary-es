{:tier :glm-5.2, :verse 15, :comments ["<b>Y purgó el altar.</b> Lo purgó y lo purificó de lo extraño, para introducirlo en la santidad." "<b>Y lo consagró.</b> Mediante este servicio." "<b>Para hacer expiación sobre él.</b> De ahora en adelante, todas las expiaciones [vienen sobre él]."], :book "leviticus", :voice :rashi, :lang :es, :chapter 8, :timestamp "2026-08-02T09:37:41.071586320Z", :translated-from :en, :model "glm-5.2"}