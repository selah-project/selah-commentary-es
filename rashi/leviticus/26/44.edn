{:tier :glm-5.2, :verse 44, :comments ["<b>Y a pesar de aun esto.</b> Y aun si traigo sobre ellos esta calamidad que he declarado <b>cuando estén en la tierra de sus enemigos</b> — no los rechazaré para destruirlos ni para anular Mi pacto con ellos."], :book "leviticus", :voice :rashi, :lang :es, :chapter 26, :timestamp "2026-08-02T09:41:42.612525827Z", :translated-from :en, :model "glm-5.2"}