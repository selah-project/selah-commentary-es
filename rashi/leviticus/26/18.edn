{:tier :glm-5.2, :verse 18, :comments ["<b>Y si aun después de estas.</b> Y si mientras estas aún <b>no escucháis</b>." "<b>Añadiré.</b> Más castigos además." "<b>Siete por vuestros pecados.</b> Siete castigos por las siete transgresiones mencionadas arriba."], :book "leviticus", :voice :rashi, :lang :es, :chapter 26, :timestamp "2026-08-02T09:41:28.618262604Z", :translated-from :en, :model "glm-5.2"}