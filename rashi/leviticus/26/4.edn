{:tier :glm-5.2, :verse 4, :comments ["<b>A su tiempo.</b> En una hora en que la gente no suele salir — por ejemplo, en las noches de Shabat (Sifra; Ta'anit 23)." "<b>Y el árbol del campo.</b> Son árboles estériles, y están destinados a producir fruto (Sifra)."], :book "leviticus", :voice :rashi, :lang :es, :chapter 26, :timestamp "2026-08-02T09:41:22.707402345Z", :translated-from :en, :model "glm-5.2"}