{:tier :glm-5.2, :verse 13, :comments ["<b>Y su ofrenda de harina.</b> La ofrenda de harina de sus libaciones." "<b>Dos décimas.</b> Era el doble." "<b>Y su libación de vino, un cuarto de hin.</b> A pesar de que su ofrenda de harina es doble, sus libaciones no se duplican."], :book "leviticus", :voice :rashi, :lang :es, :chapter 23, :timestamp "2026-08-02T09:40:34.587033956Z", :translated-from :en, :model "glm-5.2"}