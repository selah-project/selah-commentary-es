{:tier :glm-5.2, :verse 15, :comments ["<b>Desde el día siguiente del Shabat.</b> Desde el día siguiente de la fiesta." "<b>Serán completos.</b> Esto enseña que se comienza y se cuenta desde la tarde — pues de otro modo no son completos (Sifra; Menajot 66)."], :book "leviticus", :voice :rashi, :lang :es, :chapter 23, :timestamp "2026-08-02T09:40:37.352720161Z", :translated-from :en, :model "glm-5.2"}