{:tier :glm-5.2, :verse 20, :comments ["<b>Y si no redime el campo.</b> El que lo consagró." "<b>Y si lo vendió.</b> El tesorero." "<b>El campo, a otro hombre — no será redimido nunca más.</b> Para volver a la mano del que lo consagró."], :book "leviticus", :voice :rashi, :lang :es, :chapter 27, :timestamp "2026-08-02T09:41:50.328041318Z", :translated-from :en, :model "glm-5.2"}