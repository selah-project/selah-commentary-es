{:tier :glm-5.2, :verse 10, :comments ["<b>Mezclada con aceite.</b> Esta es la ofrenda de grano de ofrenda voluntaria." "<b>Y seca.</b> Esta es la ofrenda de grano del pecador y la ofrenda de grano de los celos, en las cuales no hay aceite."], :book "leviticus", :voice :rashi, :lang :es, :chapter 7, :timestamp "2026-08-02T09:37:24.539167005Z", :translated-from :en, :model "glm-5.2"}