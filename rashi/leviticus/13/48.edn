{:tier :glm-5.2, :verse 48, :comments ["<b>De lino o de lana.</b> De lino o de lana." "<b>O de cuero.</b> Es cuero al que no se le ha hecho ningún trabajo." "<b>O en cualquier obra de cuero.</b> Es cuero al que se le ha hecho algún trabajo."], :book "leviticus", :voice :rashi, :lang :es, :chapter 13, :timestamp "2026-08-02T09:38:38.422913164Z", :translated-from :en, :model "glm-5.2"}