{:tier :glm-5.2, :verse 30, :comments ["<b>Y en ella hay pelo amarillo.</b> Que el pelo negro que estaba en ella se ha vuelto amarillo." "<b>Es un netek.</b> Ese es el nombre de la afección que se da en un lugar donde hay pelo."], :book "leviticus", :voice :rashi, :lang :es, :chapter 13, :timestamp "2026-08-02T09:38:31.060053937Z", :translated-from :en, :model "glm-5.2"}