{:tier :glm-5.2, :verse 39, :comments ["<b>El trabajo de un esclavo.</b> Trabajo denigrante, en el que se reconozca que es como un esclavo — que no lleve sus prendas detrás de él al baño, y que no se ponga los zapatos (cf. Sifra)."], :book "leviticus", :voice :rashi, :lang :es, :chapter 25, :timestamp "2026-08-02T09:41:14.271030977Z", :translated-from :en, :model "glm-5.2"}