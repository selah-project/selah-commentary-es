{:tier :glm-5.2, :verse 1, :comments ["<b>Una vid estéril</b> — solo ella no tiene poder para dar fruto, y no hay fruto." "<b>La tuvo por</b> — él calculó que daría su fruto, y vino a ser como una vid estéril, pues cuando multipliqué su fruto — ellos multiplicaron los altares."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 10, :timestamp "2026-07-27T21:30:42.166779982Z", :translated-from :en, :model "glm-5.2"}