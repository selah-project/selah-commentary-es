{:tier :glm-5.2, :verse 5, :comments ["<b>לעגלות</b> — estos son los becerros de oro en Betel." "<b>יגורו</b> — los habitantes de Shomrón temerán." "<b>כי אבל עליו</b> — el sentido: sobre cada becerro en Betel cuando sea destruido." "<b>וכמריו</b> — los que se alegraron por él hoy harán duelo." "<b>כי</b> — el sentido es doble."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 10, :timestamp "2026-07-27T21:30:45.526008236Z", :translated-from :en, :model "glm-5.2"}