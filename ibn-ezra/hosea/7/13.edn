{:tier :glm-5.2, :verse 13, :comments ["<b>¡Ay!</b> — el sentido de <b>se extraviaron</b> es que huían. La destrucción vendrá sobre ellos." "<b>Pero en cuanto a mí</b> — en mi corazón y pensamiento, para redimirlos. Pero ellos decían: «todo su corazón es para hacernos mal.»"], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 7, :timestamp "2026-07-27T21:30:28.643220870Z", :translated-from :en, :model "glm-5.2"}