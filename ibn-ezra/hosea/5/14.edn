{:tier :glm-5.2, :verse 14, :comments ["<b>Pues</b> — Al principio él dijo: 'Y soy como polilla a Efraín, y como carcoma a la casa de Yehudá' (Hoshea 5:12), es decir, desde dentro del cuerpo. Y ahora, cuando hiere desde fuera — 'y quién te sanará.'"], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:30:16.590186046Z", :translated-from :en, :model "glm-5.2"}