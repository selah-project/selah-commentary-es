{:tier :glm-5.2, :verse 13, :comments ["<b>וירא, את מזורו</b> — una herida que necesita vendaje." "<b>וישלח</b> — Yehudá, pues así está después." "<b>ירב</b> — un nombre de lugar en Asiria." "<b>יגהה</b> — como 'hará bien'; גהה del aspecto del ojo."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:30:16.734889021Z", :translated-from :en, :model "glm-5.2"}