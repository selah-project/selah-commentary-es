{:tier :glm-5.2, :verse 15, :comments ["<b>Todos</b> — El sentido de <b>en Guilgal</b>: es el lugar donde estaban cuando cruzaron el Jordán. Era apropiado que recordaran Mi bondad, puesto que sus padres estuvieron allí — Yo los traje a Mi tierra, y ahora los expulsaré de Mi casa."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 9, :timestamp "2026-07-27T21:30:41.174340713Z", :translated-from :en, :model "glm-5.2"}