{:tier :glm-5.2, :verse 6, :comments ["<b>Pues he aquí que se han ido</b> — por temor al pillaje que vendrá sobre ellos, algunos de ellos morirán en Egipto y también en los caminos. Por eso dijo: «codiciarán su plata», y he aquí que irán a saquear."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 9, :timestamp "2026-07-27T21:30:37.023566217Z", :translated-from :en, :model "glm-5.2"}