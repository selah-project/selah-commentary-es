{:tier :glm-5.2, :verse 9, :comments ["<b>Porque han subido</b> — como un asno salvaje.</n>" "<b>Solos</b> — porque su consejo no era uno." "<b>Ellos contratan amantes</b> — de la raíz de אתנן, pues cada uno daba ofrendas voluntarias a los príncipes de las naciones."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 8, :timestamp "2026-07-27T21:30:32.944959392Z", :translated-from :en, :model "glm-5.2"}