{:tier :glm-5.2, :verse 1, :comments ["<b>תאשם</b> — será asolada." "<b>בחרב יפלו</b> — su gente." "<b>והריותיו</b> — puesto que la palabra está en femenino, no dudó en decir יבוקעו, como el patrón de אם תעירו ואם תעוררו."], :book "hosea", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T21:31:09.892574963Z", :translated-from :en, :model "glm-5.2"}