{:tier :glm-5.2, :verse 1, :comments ["<b>Para el director, sobre Yonat Elem</b> — se refiere a un poema de Najum cuyo comienzo es <b>Yonat Elem Reḥokim</b>." "<b>Mictam</b> — una cosa preciosa, como el oro puro."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 56, :timestamp "2026-07-27T22:10:33.841056462Z", :translated-from :en, :model "glm-5.2"}