{:tier :glm-5.2, :verse 5, :comments ["<b>Amas</b> — más. Y algunos dicen: en vez de. Pero en esta lengua no lo hemos encontrado." "<b>Mentira</b> — que él habló, aunque Ahimélek sabía que David huía; por eso fue muerto." "<b>Amas</b> — el sentido es: amas el mal."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 52, :timestamp "2026-07-27T22:10:17.566818373Z", :translated-from :en, :model "glm-5.2"}