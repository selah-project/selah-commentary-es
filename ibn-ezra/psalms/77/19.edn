{:tier :glm-5.2, :verse 19, :comments ["<b>Voz</b> — No te asombres de que lo haya mencionado en conexión con גלגל (esfera), pues en la esfera están los sonidos del trueno, solo porque está en el aire, el cual gira envolvente."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 77, :timestamp "2026-07-27T22:13:07.135984815Z", :translated-from :en, :model "glm-5.2"}