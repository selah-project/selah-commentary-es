{:tier :glm-5.2, :verse 4, :comments ["<b>Restaura</b> — el poeta habla en el lenguaje de Israel." "<b>Como arroyos</b> — como aguas impetuosas." "<b>En el Néguev</b> — siempre hace calor, por el sol, o según el lenguaje del Targum: נגובו מיא (las aguas se secaron)."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 126, :timestamp "2026-07-27T22:19:48.337234366Z", :translated-from :en, :model "glm-5.2"}