{:tier :glm-5.2, :verse 11, :comments ["<b>Regocíjense</b> — los justos que no han pecado, ellos se regocijan porque ninguna enfermedad vendrá sobre ellos, pues su sanador, que es HaShem, es su guardián, y Él quitará toda enfermedad que se halle en su alimento."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 32, :timestamp "2026-07-27T22:07:47.813609049Z", :translated-from :en, :model "glm-5.2"}