{:tier :glm-5.2, :verse 2, :comments ["<b>Oíd</b> — este es el asunto que está a punto de dar a conocer. Abarca a todos los seres vivientes en quienes HaShem insufló el aliento de vida por Sus narices; por tanto: «Dad oído, todos los habitantes del mundo.»"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 49, :timestamp "2026-07-27T22:09:48.945385481Z", :translated-from :en, :model "glm-5.2"}