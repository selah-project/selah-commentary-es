{:tier :glm-5.2, :verse 4, :comments ["<b>Mi boca</b> — enseña concerniente a toda sabiduría escondida de ellos, y los sabios de corazón la mencionarán a modo de enigma." "<b>Y el sentido de \"medito\" y \"discierno\"</b> — que mi corazón meditó."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 49, :timestamp "2026-07-27T22:09:51.095819179Z", :translated-from :en, :model "glm-5.2"}