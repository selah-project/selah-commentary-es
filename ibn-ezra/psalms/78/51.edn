{:tier :glm-5.2, :verse 51, :comments ["<b>Y él hirió</b> — Mencionó a Ham, su padre, a manera de deficiencia y deshonra para ellos." "<b>Y el primero de su fuerza</b> — El comienzo de los hijos, en quienes se ve la fuerza del padre."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 78, :timestamp "2026-07-27T22:13:29.559372915Z", :translated-from :en, :model "glm-5.2"}