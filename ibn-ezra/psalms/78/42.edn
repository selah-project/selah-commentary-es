{:tier :glm-5.2, :verse 42, :comments ["<b>No</b> — El sentido: no temieron la plaga con la que Él golpeó a los egipcios en la muerte de los primogénitos. Y este es el sentido de: el día en que los redimió del adversario."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 78, :timestamp "2026-07-27T22:13:25.359292791Z", :translated-from :en, :model "glm-5.2"}