{:tier :glm-5.2, :verse 67, :comments ["<b>Y los rechazó</b> — Desde aquel tiempo, el Arca nunca estuvo en la porción de Efraím, sino que iba de tienda en tienda y de lugar en lugar hasta que vino David, y el Arca estuvo en la ciudad de Tzión."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 78, :timestamp "2026-07-27T22:13:36.830758751Z", :translated-from :en, :model "glm-5.2"}