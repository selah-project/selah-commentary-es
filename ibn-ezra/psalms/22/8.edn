{:tier :glm-5.2, :verse 8, :comments ["<b>Todas</b> — Las formas son como לעג, ligadas siempre con una lamed." "<b>Abren con el labio</b> — Abren, como פטר רחם, y la bet es una figura de lenguaje, como לחמו בלחמי. Y es posible que falte una palabra."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T22:06:43.328242262Z", :translated-from :en, :model "glm-5.2"}