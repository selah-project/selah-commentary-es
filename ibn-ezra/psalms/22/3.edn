{:tier :glm-5.2, :verse 3, :comments ["<b>Mi Elohim</b> — El prodigio es que Tú seas mi Elohim, ¡y cómo no respondes?! El sentido: pues no tengo otro Elohim además de Ti, y clamo ni un momento y me callo — antes bien, no tengo silencio."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T22:06:41.225470874Z", :translated-from :en, :model "glm-5.2"}