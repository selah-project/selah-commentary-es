{:tier :glm-5.2, :verse 1, :comments ["<b>Para el director, de Yedutún.</b> La belleza del piyut es que su comienzo sea 'de Yedutún': o bien Yedutún el poeta lo compuso, o bien otro lo compuso sobre él, pues se trata de un instrumento lejano."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 62, :timestamp "2026-07-27T22:11:02.322381888Z", :translated-from :en, :model "glm-5.2"}