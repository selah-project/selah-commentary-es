{:tier :glm-5.2, :verse 1, :comments ["<b>Para el director. ¿Hasta cuándo?</b> — el significado: si no es librado de sus enemigos, parecerá muerto ante los ojos de los hombres, porque su Elohim lo ha olvidado, o no sabe lo que le ha acontecido."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 13, :timestamp "2026-07-27T22:05:45.438547601Z", :translated-from :en, :model "glm-5.2"}