{:tier :glm-5.2, :verse 4, :comments ["<b>Mi Elohim</b> — El significado de <b>en tu justicia</b> ha sido aclarado [arriba]." "<b>Y la fosa</b> — como: <b>אשרו חמוץ</b> (\"su muro está podrido\"), en el sentido de una fosa corroída."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 71, :timestamp "2026-07-27T22:12:07.693125877Z", :translated-from :en, :model "glm-5.2"}