{:tier :glm-5.2, :verse 10, :comments ["<b>כי, לי</b> — por mi causa, como en פן יאמרו אויבי לי." "<b>ושומרי נפשי</b> — los que yo pensaba que eran mis ayudantes, consultaron juntos con mis enemigos."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 71, :timestamp "2026-07-27T22:12:10.673272873Z", :translated-from :en, :model "glm-5.2"}