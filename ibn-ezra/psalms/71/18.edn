{:tier :glm-5.2, :verse 18, :comments ["<b>Tu brazo</b> — el poder de Tu brazo." "<b>A la generación</b> — por venir." "<b>A todos los que vienen</b> — a todos los que habrán de venir. El sentido: que nacerán, como en: «Una generación va y otra generación viene.»"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 71, :timestamp "2026-07-27T22:12:14.422788781Z", :translated-from :en, :model "glm-5.2"}