{:tier :glm-5.2, :verse 10, :comments ["<b>אשר</b> — que tienen el poder de tramar artimañas y urdir medios para aceptar sobornos y dinero. Y algunos dicen: todo su designio es 'tomar en su mano', y asimismo 'y su mano derecha', y el sentido está duplicado."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 26, :timestamp "2026-07-27T22:07:11.504607488Z", :translated-from :en, :model "glm-5.2"}