{:tier :glm-5.2, :verse 2, :comments ["<b>Mi corazón está firme:</b> para que yo cante." "<b>También mi kavod:</b> está firme, como en «Mi corazón se alegra y mi kavod se regocija». Rabí Moshé dijo: «También mi kavod» cantará."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 108, :timestamp "2026-07-27T22:17:28.537871694Z", :translated-from :en, :model "glm-5.2"}