{:tier :glm-5.2, :verse 24, :comments ["<b>Y él aumentó</b> — Volvió a שלח מלאך, y la palabra es del binyán pesado [intensivo], el adicional." "<b>Y lo hizo más fuerte</b> — más que sus enemigos — estos son los egipcios."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 105, :timestamp "2026-07-27T22:16:45.087665462Z", :translated-from :en, :model "glm-5.2"}