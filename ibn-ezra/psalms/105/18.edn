{:tier :glm-5.2, :verse 18, :comments ["<b> afligido</b> — No especificó los verbos, y esto fue mientras estaba en la cárcel." "<b> su alma</b> — una metáfora por su propia cuenta. Y falta una bet en 'ברזל' (en hierro); 'su alma entró'."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 105, :timestamp "2026-07-27T22:16:43.297782540Z", :translated-from :en, :model "glm-5.2"}