{:tier :glm-5.2, :verse 20, :comments ["<b>Cómo</b> — Y estos hablantes [en] 'ataq no conocían el bien que has escondido para los que te temen. Y ya has hecho muchos bienes a la vista para los que se refugian en Ti. Este es el sentido de 'delante de los hombres'."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 31, :timestamp "2026-07-27T22:07:40.760290253Z", :translated-from :en, :model "glm-5.2"}