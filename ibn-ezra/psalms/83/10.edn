{:tier :glm-5.2, :verse 10, :comments ["<b>Hazles como a Midián</b> — como hiciste a Midián en las guerras de Gideón." "<b>Junto al torrente de Kishón</b> — pues allí murieron los príncipes del campamento de Sísara: «El torrente de Kishón los barrió.»"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 83, :timestamp "2026-07-27T22:14:08.413365314Z", :translated-from :en, :model "glm-5.2"}