{:tier :glm-5.2, :verse 5, :comments ["<b>און, sobre su lecho</b> — de noche." "<b>יתיצב</b> — lo opuesto a estar acostado, de día." "<b>de manera que no es buena</b> — un precepto negativo." "<b>no desprecia el mal</b> — el sentido es doble."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 36, :timestamp "2026-07-27T22:08:20.121031863Z", :translated-from :en, :model "glm-5.2"}