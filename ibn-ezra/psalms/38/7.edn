{:tier :glm-5.2, :verse 7, :comments ["<b>Estoy encorvado</b> — No tengo fuerzas para mantenerme erguido, recto; por eso estoy encorvado e inclinado, y mi apariencia ha cambiado, como si el sol me hubiera golpeado todo el día. Este es el significado de 'ando oscurecido.'"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 38, :timestamp "2026-07-27T22:08:42.844818750Z", :translated-from :en, :model "glm-5.2"}