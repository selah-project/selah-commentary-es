{:tier :glm-5.2, :verse 11, :comments ["<b>Mi corazón divaga</b> — como en el Targum: no se puede hallar reposo en torno a él." "<b>Mi fuerza</b> — fuerza física." "<b>Y la luz de mis ojos</b> — así es el camino de los enfermos."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 38, :timestamp "2026-07-27T22:08:43.873071626Z", :translated-from :en, :model "glm-5.2"}