{:tier :glm-5.2, :verse 13, :comments ["<b>וינקשו</b> — La palabra נפשי rige por cuenta de otro, y así es וינקשו מבקשי נפשי, pues es el pu'al. El significado: sus palabras son un lazo para mí."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 38, :timestamp "2026-07-27T22:08:45.578818208Z", :translated-from :en, :model "glm-5.2"}