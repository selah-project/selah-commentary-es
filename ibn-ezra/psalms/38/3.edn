{:tier :glm-5.2, :verse 3, :comments ["<b>Porque</b> — <b>se han hundido</b>: conjugación nifal, como ננחתו, del paradigma de ותנחת עלי ידך (Job 13:21). El significado: enfermedades y dolores como flechas."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 38, :timestamp "2026-07-27T22:08:40.652592689Z", :translated-from :en, :model "glm-5.2"}