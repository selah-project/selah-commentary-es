{:tier :glm-5.2, :verse 3, :comments ["<b>שפטו</b> — Haced justicia al huérfano, que no tiene quien lo ayude, que no puede hablar, y a la viuda, que no tiene marido que la defienda, porque los impíos les hacen violencia y tú les muestras favoritismo."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 82, :timestamp "2026-07-27T22:14:01.166149587Z", :translated-from :en, :model "glm-5.2"}