{:tier :glm-5.2, :verse 9, :comments ["<b>Y reprendería</b> — Comparó al viento del este con una reprensión." "<b>En las profundidades</b> — lugares bajos." "<b>Como un desierto</b> — donde no hay agua, pues ellos les eran un muro."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 106, :timestamp "2026-07-27T22:16:56.701797500Z", :translated-from :en, :model "glm-5.2"}