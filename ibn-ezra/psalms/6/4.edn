{:tier :glm-5.2, :verse 4, :comments ["<b>Y mi alma</b> — pues está unida al cuerpo, se alarma más que el cuerpo; por eso la palabra מאד (sobremanera)." "<b>¿Hasta cuándo?</b> — se alarmará mi alma, ¿que no tiene fuerzas para soportar?"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T22:05:06.126466709Z", :translated-from :en, :model "glm-5.2"}