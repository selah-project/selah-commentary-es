{:tier :glm-5.2, :verse 22, :comments ["<b>Porque soy pobre</b> — un verbo en tiempo pasado de la raíz חלל, por lo tanto la lamed lleva un pataj. Y algunos dicen: de la raíz de חולל (formado hueco)."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 109, :timestamp "2026-07-27T22:17:38.187527708Z", :translated-from :en, :model "glm-5.2"}