{:tier :glm-5.2, :verse 6, :comments ["<b>¡Cuán!</b> — No puedo comprenderlos, porque Tus pensamientos son demasiado grandes para mí." "<b>Sumamente profundos</b> — son grandes en el sentido de sublimes, estando en lo alto arriba; lo opuesto a esto es profundo — todo es relativo al hombre."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 92, :timestamp "2026-07-27T22:15:17.164694537Z", :translated-from :en, :model "glm-5.2"}