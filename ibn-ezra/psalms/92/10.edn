{:tier :glm-5.2, :verse 10, :comments ["<b>Porque he aquí Tus enemigos</b> — A veces el maskil escuchó lo que aconteció a los impíos, y también vio lo mismo en sus propios días muchas veces: que los enemigos de HaShem terminan en destrucción."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 92, :timestamp "2026-07-27T22:15:18.401053862Z", :translated-from :en, :model "glm-5.2"}