{:tier :glm-5.2, :verse 10, :comments ["<b>אומרה</b> — la razón de <b>סלעי</b> [mi Roca] es que <b>סלעי</b> vino primero." "<b>למה שכחתני</b> — el sentido es a causa de la prolongación del exilio." "<b>למה קודר אלך</b> — como un doliente que se viste de prendas oscuras."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 42, :timestamp "2026-07-27T22:09:11.966111691Z", :translated-from :en, :model "glm-5.2"}