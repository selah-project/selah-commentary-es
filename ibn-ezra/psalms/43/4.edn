{:tier :glm-5.2, :verse 4, :comments ["<b>ואבואה אל מזבח אלהים</b> [—] <b>אל</b> — que es el gozo de mi alegría." "Y el sentido de <b>אלהים אלהי</b> — que una nación no santa tema, que Tú eres mi Elohim."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 43, :timestamp "2026-07-27T22:09:14.530465041Z", :translated-from :en, :model "glm-5.2"}