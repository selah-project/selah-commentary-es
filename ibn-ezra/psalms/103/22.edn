{:tier :glm-5.2, :verse 22, :comments ["<b>Bendice</b> — todas Sus obras, es decir, los metales, las plantas y todos los seres vivientes, pues Él gobierna en ellos. Y después Él completó, como comenzó, <i>Bendice, alma mía, HaShem</i>."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 103, :timestamp "2026-07-27T22:16:20.854279687Z", :translated-from :en, :model "glm-5.2"}