{:tier :glm-5.2, :verse 18, :comments ["<b>Cercano</b> — Si el rey está lejos, no puede salvar a los que lo invocan, pero HaShem está cercano siempre — solo a aquellos que lo invocan en verdad y no para ponerlo a prueba, y a uno que no es digno de ser salvado."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 145, :timestamp "2026-07-27T22:21:19.067634750Z", :translated-from :en, :model "glm-5.2"}