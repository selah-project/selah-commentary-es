{:tier :glm-5.2, :verse 26, :comments ["<b>כי</b> — ¿qué esperanza tenemos, nosotros y nuestras almas, que somos de los cielos superiores?" "<b>שחה לעפר</b> — y el apego a la tierra, eso es la tumba." "Y el sentido de <b>בטננו</b> — es el cuerpo."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 44, :timestamp "2026-07-27T22:09:24.961453929Z", :translated-from :en, :model "glm-5.2"}