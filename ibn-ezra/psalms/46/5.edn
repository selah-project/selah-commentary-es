{:tier :glm-5.2, :verse 5, :comments ["<b>Un río:</b> El sentido es: si sus aguas fueran represadas — el río de Jerusalén, que era el Guijón." "<b>Sus arroyos:</b> todos los que habitan en la ciudad de Elohim, que es santa [—] la morada del Altísimo."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 46, :timestamp "2026-07-27T22:09:37.046937203Z", :translated-from :en, :model "glm-5.2"}