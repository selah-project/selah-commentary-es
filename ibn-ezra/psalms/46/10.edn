{:tier :glm-5.2, :verse 10, :comments ["<b>Él hace cesar</b> — desde Jerusalén; tal vez por el espíritu de santidad respecto al asunto de Gog." "<b>Él quema con fuego</b> — el sentido es 'en Su ira'; y los carros que traen en ellos las armas, o el alimento de los combatientes."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 46, :timestamp "2026-07-27T22:09:37.886858724Z", :translated-from :en, :model "glm-5.2"}