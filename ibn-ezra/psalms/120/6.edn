{:tier :glm-5.2, :verse 6, :comments ["<b>רבת</b> — La tav en lugar de heh, como <b>ושבת</b>. Es un modificador cuyo sustantivo modificado está ausente, como una medida de tiempo y sus semejantes. Esto es una alusión a la duración del exilio."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 120, :timestamp "2026-07-27T22:19:33.343923516Z", :translated-from :en, :model "glm-5.2"}