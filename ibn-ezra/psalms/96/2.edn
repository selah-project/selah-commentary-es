{:tier :glm-5.2, :verse 2, :comments ["<b>Cantad</b> — Su nombre honroso, que es el nombre propio [es decir, el Tetragrámaton]." "<b>Proclamad</b> — Vosotros, oh pueblo de YHWH, a un dios. [Alternativamente: Vosotros, pueblo de YHWH, sois para un dios.]"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 96, :timestamp "2026-07-27T22:15:38.754825016Z", :translated-from :en, :model "glm-5.2"}