{:tier :glm-5.2, :verse 2, :comments ["<b>Alzad vuestras manos</b> — de día, y esto es וישא אהרן את ידיו (y Aharón alzó sus manos)." "<b>y bendecid a YHWH</b> — en este día, es decir, la Bendición Sacerdotal."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 134, :timestamp "2026-07-27T22:20:11.944761197Z", :translated-from :en, :model "glm-5.2"}