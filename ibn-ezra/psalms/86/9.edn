{:tier :glm-5.2, :verse 9, :comments ["<b>Todas</b> — Cuando las naciones que me rodean vean que estoy en gran angustia, al ellas contar a otros que Tú me salvaste, pues soy pobre y necesitado, entonces las naciones vendrán a Ti para la gloria de Tu Nombre."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 86, :timestamp "2026-07-27T22:14:24.135364712Z", :translated-from :en, :model "glm-5.2"}