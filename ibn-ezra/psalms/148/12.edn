{:tier :glm-5.2, :verse 12, :comments ["<b>Jóvenes y también doncellas</b> — Los varones también difieren según las épocas, pues su fuerza a veces aumenta y a veces disminuye; por tanto: <i>ancanos con jóvenes</i>, y dijo después —"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 148, :timestamp "2026-07-27T22:21:35.697486476Z", :translated-from :en, :model "glm-5.2"}