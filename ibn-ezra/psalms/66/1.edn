{:tier :glm-5.2, :verse 1, :comments ["<b>Para el director. Gritad a Elohim.</b> No mencionó el nombre del autor, y dado que está en lenguaje plural y esto no se encuentra en la mayoría de los salmos que son de David, es por tanto posible que este salmo también pertenezca a uno de los otros poetas."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 66, :timestamp "2026-07-27T22:11:22.655542346Z", :translated-from :en, :model "glm-5.2"}