{:tier :glm-5.2, :verse 15, :comments ["<b>los grasos:</b> מחים sigue el patrón de מתים, y el nombre [divino] está ausente. Asimismo, las \"ovejas gruesas\" son aquellas que poseen מח (meollo)." "<b>carneros:</b> son los grandes." "<b>Selah:</b> en verdad."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 66, :timestamp "2026-07-27T22:11:29.404676672Z", :translated-from :en, :model "glm-5.2"}