{:tier :glm-5.2, :verse 12, :comments ["<b>Si</b> — Rabí Moshé dijo: Si yo fuera como un hombre que tiene necesidades, no buscaría que se me diera de lo que él tiene, cuando él tiene poco y todo está en Mi mano — con mayor razón [cuando] yo no tengo necesidad."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 50, :timestamp "2026-07-27T22:10:02.900200719Z", :translated-from :en, :model "glm-5.2"}