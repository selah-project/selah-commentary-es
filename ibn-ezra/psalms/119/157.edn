{:tier :glm-5.2, :verse 157, :comments ["<b>Muchos</b> — yo solo no me desvié; más bien, ellos se desviaron. Ahora bien, נטיתי es un verbo intransitivo, como סרתי. Si fuera transitivo, carecería de [objeto después de] לבי."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 119, :timestamp "2026-07-27T22:19:24.811468850Z", :translated-from :en, :model "glm-5.2"}