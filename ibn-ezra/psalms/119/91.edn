{:tier :glm-5.2, :verse 91, :comments ["<b>למשפטיך</b> — Mencionó los cielos y la tierra, y ellos se mantienen como siervos para ejecutar Tus juicios, en la manera del versículo: «Los llamo, que se presenten juntos.»"], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 119, :timestamp "2026-07-27T22:19:02.003737137Z", :translated-from :en, :model "glm-5.2"}