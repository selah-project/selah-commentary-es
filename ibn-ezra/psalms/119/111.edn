{:tier :glm-5.2, :verse 111, :comments ["<b>נחלתי</b> — El significado es: נחלתי, para que me regocije en ella." "<b>ועדותיך</b> — Son las maravillas que Tú realizaste, que mis antepasados transmitieron, y me regocijo como si hubiera sido testigo en aquellos días."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 119, :timestamp "2026-07-27T22:19:09.743144877Z", :translated-from :en, :model "glm-5.2"}