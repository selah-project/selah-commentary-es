{:tier :glm-5.2, :verse 107, :comments ["<b>Estoy sumamente afligido</b> — si la angustia ha venido sobre mí y he sido afligido con tormentos: <i>dadme vida</i> (<b>חייני</b>) — conforme a Tu palabra, la cual una persona cumple y vive por ellas."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 119, :timestamp "2026-07-27T22:19:08.138306270Z", :translated-from :en, :model "glm-5.2"}