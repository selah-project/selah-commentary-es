{:tier :glm-5.2, :verse 11, :comments ["<b>Él dice</b> — El impío admite que hay un El, solo que Él no tiene conocimiento, al estilo de: «¿Cómo sabe El» (Salmos 73:11)." "<b>Él no ve</b> — El sentido está duplicado, como es lo habitual."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 10, :timestamp "2026-07-27T22:05:35.964863008Z", :translated-from :en, :model "glm-5.2"}