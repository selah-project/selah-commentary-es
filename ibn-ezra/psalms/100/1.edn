{:tier :glm-5.2, :verse 1, :comments ["<b>Salmo de acción de gracias. Gritad a YHWH, toda la tierra</b> — como en <b>cuando un país peque contra Mí</b> [Ezequiel 14:13], pues allí <b>la tierra</b> es un término general que incluye a todos los que la habitan."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 100, :timestamp "2026-07-27T22:15:54.109435511Z", :translated-from :en, :model "glm-5.2"}