{:tier :glm-5.2, :verse 1, :comments ["<b>Para el director. El necio dijo</b> — lo opuesto a sabio, porque imagina que no hay Elohim; por tanto ha corrompido su camino y ha hecho viles sus obras, como <i>y en tus obras reflexionaré</i>; no hay quien haga el bien."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T22:05:47.981046640Z", :translated-from :en, :model "glm-5.2"}