{:tier :glm-5.2, :verse 2, :comments ["<b>Verdaderamente silencioso.</b> Algunos dicen que אלם es un grupo, como מאלמים אלומים. Y dijo Rabí Moshé: porque enmudeciste de hablar esta justicia — que es decir la verdad."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 58, :timestamp "2026-07-27T22:10:43.883760044Z", :translated-from :en, :model "glm-5.2"}