{:tier :glm-5.2, :verse 10, :comments ["<b>No vendrá sobre</b> — una circunlocución, como: «vino sobre él»." "<b>Mal</b> — estas son las enfermedades." "<b>En tu tienda</b> — a modo de parábola, como: «y HaShem pasará sobre el umbral de la puerta»."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 91, :timestamp "2026-07-27T22:15:11.978011660Z", :translated-from :en, :model "glm-5.2"}