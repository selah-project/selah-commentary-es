{:tier :glm-5.2, :verse 14, :comments ["<b>Pues</b>, <b>Su pueblo</b> — en correspondencia con «Tu pueblo, oh YHWH, ellos aplastan»." "<b>Y Su heredad</b> — en correspondencia con «y Tu heredad». El sentido: que no los abandonará para siempre."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 94, :timestamp "2026-07-27T22:15:29.179692491Z", :translated-from :en, :model "glm-5.2"}