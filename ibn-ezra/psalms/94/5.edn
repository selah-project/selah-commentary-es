{:tier :glm-5.2, :verse 5, :comments ["<b>Tu pueblo — ellos quebrantan.</b> Lo inverso. Y dirás: 'en el corazón' — y quebrantan en obra." "<b>Y Tu pueblo y Tu heredad</b> — lo inverso de 'los impíos'."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 94, :timestamp "2026-07-27T22:15:26.579361461Z", :translated-from :en, :model "glm-5.2"}