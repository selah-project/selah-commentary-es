{:tier :glm-5.2, :verse 6, :comments ["<b>Entre los muertos, libre</b> — de todos los mandamientos y de todos los trabajos corporales y de los reyes de la tierra." "<b>A quienes ya no recuerdas</b> — como señal de que vendrá un tiempo y estación señalada en que los muertos serán recordados."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 88, :timestamp "2026-07-27T22:14:32.329848015Z", :translated-from :en, :model "glm-5.2"}