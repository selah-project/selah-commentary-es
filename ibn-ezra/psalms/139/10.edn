{:tier :glm-5.2, :verse 10, :comments ["<b>Aun allí</b> — no podría ir a los confines del mar, a menos que Tu mano me guiará." "<b>Y Tu mano me guía, y Tu diestra me sostiene</b> — es como si huyera de Tu mano a Tu mano."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 139, :timestamp "2026-07-27T22:20:41.233161974Z", :translated-from :en, :model "glm-5.2"}