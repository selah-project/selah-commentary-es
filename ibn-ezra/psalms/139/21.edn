{:tier :glm-5.2, :verse 21, :comments ["<b>¿No los odio?</b> — Los odio con toda mi fuerza." "<b>los que se levantan contra Ti</b> — [es] un adjetivo." "<b>¿no soy yo aborrecido?</b> — como אקוט en דור; y el sentido es doble."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 139, :timestamp "2026-07-27T22:20:46.995339260Z", :translated-from :en, :model "glm-5.2"}