{:tier :glm-5.2, :verse 13, :comments ["<b>Gotean</b> — he aquí, Tus circuitos están en la tierra habitada." "<b>Praderas del desierto</b> — como: נות רועים (praderas de pastores)." "<b>Y las colinas se ciñen de alegría</b> — cuando aparecen la hierba y el follaje."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 65, :timestamp "2026-07-27T22:11:21.846819202Z", :translated-from :en, :model "glm-5.2"}