{:tier :glm-5.2, :verse 49, :comments ["<b>Quién</b> — El significado aquí es: he aquí, yo muero, ¿y por qué he soportado el yugo del exilio? Así también él dice: «He llevado en mi seno la multitud de pueblos»."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 89, :timestamp "2026-07-27T22:14:56.930299527Z", :translated-from :en, :model "glm-5.2"}