{:tier :glm-5.2, :verse 26, :comments ["<b>Y pondré</b> — Puesto que mencionó que HaShem se enseñorea de la soberbia del mar, mencionó que Él otorgará una porción del poder a David para prevalecer sobre los que navegan en barcos por el mar y por los ríos."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 89, :timestamp "2026-07-27T22:14:48.080898874Z", :translated-from :en, :model "glm-5.2"}