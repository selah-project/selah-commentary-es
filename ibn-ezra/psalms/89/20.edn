{:tier :glm-5.2, :verse 20, :comments ["<b>Entonces, a tus devotos</b> — los cantores, como Heman y Etán, que eran llamados videntes y profetas." "<b>Y un joven</b> — como נבחר [elegido], o porque lo era en su reino."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 89, :timestamp "2026-07-27T22:14:45.930756570Z", :translated-from :en, :model "glm-5.2"}