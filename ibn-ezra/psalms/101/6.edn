{:tier :glm-5.2, :verse 6, :comments ["<b>Mis ojos están sobre los fieles de la tierra</b> — cuando me siento en el trono del juicio, incluso uno que no me sirve ni se presenta delante de mí en el tiempo del juicio, sino más bien uno que camina por el camino de la integridad."], :book "psalms", :voice :ibn-ezra, :lang :es, :chapter 101, :timestamp "2026-07-27T22:15:58.547831402Z", :translated-from :en, :model "glm-5.2"}