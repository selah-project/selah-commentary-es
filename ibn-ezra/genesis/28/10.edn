{:tier :glm-5.2, :verse 10, :comments ["<b>El Gaón [Saadia] dijo</b> que וילך חרנה es ponerse en camino, y no solo en su sentido llano, y la Escritura vuelve para explicar lo que encontró por el camino, y no viajó en un solo día, pues pasó la noche en el camino."], :book "genesis", :voice :ibn-ezra, :lang :es, :chapter 28, :timestamp "2026-07-27T21:26:13.545897063Z", :translated-from :en, :model "glm-5.2"}