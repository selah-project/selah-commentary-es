{:tier :glm-5.2, :verse 19, :comments ["<b>La porción del campo.</b> Una porción en el campo. Y la Escritura menciona esto para dar a conocer que la tierra de Israel tiene una gran distinción, y quien tenga una porción en ella es considerado como si tuviera una porción en el mundo por venir."], :book "genesis", :voice :ibn-ezra, :lang :es, :chapter 33, :timestamp "2026-07-27T21:27:02.936230232Z", :translated-from :en, :model "glm-5.2"}