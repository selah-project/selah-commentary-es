{:tier :glm-5.2, :verse 19, :comments ["<b>¿Estoy yo en lugar de Elohim?</b>. El Gaón [Saadia] dice: <b>¿estoy yo en lugar de Elohim?</b> — como si yo estuviera en el lugar de Elohim, pues caíste ante mí y dijiste: 'somos tus siervos.'"], :book "genesis", :voice :ibn-ezra, :lang :es, :chapter 50, :timestamp "2026-07-27T21:28:54.259331418Z", :translated-from :en, :model "glm-5.2"}