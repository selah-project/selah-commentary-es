{:tier :glm-5.2, :verse 6, :comments ["<b>wayyigaʿ</b> [llegó]: esto es antes de vestir el cilicio." "<b>wayyaʿabor</b> [pasó]: lo quitó." "<b>wayyekhas</b> [cubrió]: su cuerpo con cilicio, pues es un verbo transitivo."], :book "jonah", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:46:20.148847877Z", :translated-from :en, :model "glm-5.2"}