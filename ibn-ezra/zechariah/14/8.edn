{:tier :glm-5.2, :verse 8, :comments ["<b>Y será</b> — Esto es una señal para el futuro, y por esta causa la montaña se parte, para que de en medio de ella salgan aguas vivas por el camino del valle, y desde ahora la montaña no las bloqueará, porque está partida."], :book "zechariah", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T22:24:27.865735486Z", :translated-from :en, :model "glm-5.2"}