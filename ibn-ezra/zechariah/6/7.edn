{:tier :glm-5.2, :verse 7, :comments ["<b>Y los fuertes</b> — son los rojos solos, que estaban en el primer carro." "<b>Y buscaron ir, para recorrer la tierra</b> — hacia el este y hacia el oeste, por mandato del amo de toda la tierra; por tanto <b>dijo: Id</b>."], :book "zechariah", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T22:23:38.552347068Z", :translated-from :en, :model "glm-5.2"}