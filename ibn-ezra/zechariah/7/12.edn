{:tier :glm-5.2, :verse 12, :comments ["<b>Y su corazón</b> — obstinado. No hay poder en el hierro para grabar sobre él." "<b>La Torá</b> — la Torá de Moshé, y \"las palabras\" por mano de los profetas para reprenderlos." "<b>Y hubo gran ira</b> — sobre sus padres."], :book "zechariah", :voice :ibn-ezra, :lang :es, :chapter 7, :timestamp "2026-07-27T22:23:45.457455355Z", :translated-from :en, :model "glm-5.2"}