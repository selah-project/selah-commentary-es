{:tier :glm-5.2, :verse 1, :comments ["<b>Nevuchadnetzar:</b> Romiyyah — su altura es su estatura." "<b>Potiyyah:</b> Su anchura era de seis codos." "<b>Llanura de Dura:</b> Y habitaron allí; es la llanura de Dura."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:02:49.229663434Z", :translated-from :en, :model "glm-5.2"}