{:tier :glm-5.2, :verse 44, :comments ["<b>Y en sus días</b> — el reino del Mashíaj." "<b>No será dejado</b> — no será abandonado ni quedará." "<b>Todos</b> — y el sentido de די לא בידין (que no es por mano): no por fuerza ni por poder, sino por sí mismo, en el tiempo del fin."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 2, :timestamp "2026-07-27T21:02:46.800092654Z", :translated-from :en, :model "glm-5.2"}