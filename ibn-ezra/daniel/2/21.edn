{:tier :glm-5.2, :verse 21, :comments ["<b>Y Él</b> — según Su sabiduría cambia los tiempos, y quita reyes y establece a otros en su lugar, y lo que Él ve en Su sabiduría, y la sabiduría que un hombre conoce — Él se la da."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 2, :timestamp "2026-07-27T21:02:35.941875074Z", :translated-from :en, :model "glm-5.2"}