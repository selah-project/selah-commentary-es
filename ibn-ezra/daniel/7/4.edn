{:tier :glm-5.2, :verse 4, :comments ["<b>El primero</b> era semejante a un león y tenía alas de águila. Estuve mirando hasta que sus alas fueron arrancadas, y fue levantado de la tierra, y se le hizo ponerse de pie sobre los pies como un hombre, y le fue dado un corazón de hombre."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 7, :timestamp "2026-07-27T21:03:28.309364070Z", :translated-from :en, :model "glm-5.2"}