{:tier :glm-5.2, :verse 10, :comments ["<b>Un vigilante</b> — un ángel. Y Rabí Moshé dijo: no es un cuerpo, y está atento continuamente y no duerme." "<b>Descendió</b> — bajó. Y como ello: נחת גדודיה."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:03:07.506315525Z", :translated-from :en, :model "glm-5.2"}