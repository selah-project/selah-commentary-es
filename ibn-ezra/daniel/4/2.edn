{:tier :glm-5.2, :verse 2, :comments ["<b>חלם, וידחלינני</b> — me asustó." "<b>והרהורין</b> — la imaginación del corazón, y no tiene compañera." "<b>וחזוי ראשי</b> — porque los ojos están en la cabeza, o porque la visión está en el cerebro."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:03:04.522791028Z", :translated-from :en, :model "glm-5.2"}