{:tier :glm-5.2, :verse 16, :comments ["Y hubo — lo lleva en su alma. Y lo que fue demasiado breve para mencionar — el vino — ahora lo menciona. Y la nun de זרעונים está añadida, como en לגאיונים y muchos semejantes."], :book "daniel", :voice :ibn-ezra, :lang :es, :chapter 1, :timestamp "2026-07-27T21:02:22.670598799Z", :translated-from :en, :model "glm-5.2"}