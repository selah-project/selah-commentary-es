{:tier :glm-5.2, :verse 10, :comments ["<b>עבר</b> — en el sentido de preñez." "<b>יגעיל</b> — del lenguaje de nuestros Sabios, de bendita memoria: «lo escaldan con agua hirviendo». El significado es que la simiente de la impureza se coagulará."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 21, :timestamp "2026-07-27T21:42:48.376252424Z", :translated-from :en, :model "glm-5.2"}