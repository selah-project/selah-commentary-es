{:tier :glm-5.2, :verse 26, :comments ["<b>Con el grosor de los respaldos de sus escudos</b> — se refiere al grosor del cuello." "<b>Y sus escudos</b> — estos son los huesos, a modo de parábola." "<b>Y los respaldos</b> — estos son los tendones."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 15, :timestamp "2026-07-27T21:42:18.873060317Z", :translated-from :en, :model "glm-5.2"}