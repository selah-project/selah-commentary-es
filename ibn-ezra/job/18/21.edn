{:tier :glm-5.2, :verse 21, :comments ["<b>Tal es el lugar del que no conoce a El</b> — está transpuesto: «tal es el lugar del que no conoce a El» va primero, luego lo que está con ello. Asimismo es: «tal es el lugar del que no conoce a El» está transpuesto."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 18, :timestamp "2026-07-27T21:42:35.641355389Z", :translated-from :en, :model "glm-5.2"}