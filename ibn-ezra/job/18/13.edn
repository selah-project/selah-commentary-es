{:tier :glm-5.2, :verse 13, :comments ["<b>Los sarmientos de su piel</b> — los sarmientos de su piel, a modo de metáfora." "<b>Devora sus sarmientos</b> — son sus hijos." "<b>Primogénito de la muerte</b> — fuerza, o comienzo; y el sentido es que la muerte es primogénita en su venir."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 18, :timestamp "2026-07-27T21:42:33.023965418Z", :translated-from :en, :model "glm-5.2"}