{:tier :glm-5.2, :verse 16, :comments ["<b>Fueron cortados</b> — fueron arrancados antes de su tiempo." "<b>Un río derrama su fundamento</b> — son la gente de la generación del Diluvio, pues la tierra, que es el fundamento de la humanidad, se volvió como un río que se derrama."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T21:42:59.091080131Z", :translated-from :en, :model "glm-5.2"}