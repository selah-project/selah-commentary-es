{:tier :glm-5.2, :verse 21, :comments ["<b>Y ahora no ven luz</b> — Y he aquí, no tienen poder ni siquiera para ver la luz cuando las nubes están en los cielos. Se vuelve luminoso para el sol, y es por <b>בהרות</b>, hasta que viene un viento y despeja las nubes."], :book "job", :voice :ibn-ezra, :lang :es, :chapter 37, :timestamp "2026-07-27T21:44:31.159844466Z", :translated-from :en, :model "glm-5.2"}