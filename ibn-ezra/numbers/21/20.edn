{:tier :glm-5.2, :verse 20, :comments ["<b>Y mira hacia fuera.</b> Forma femenina, a causa del valle." "<b>La desolación.</b> Un lugar desolado. El testimonio: «y en tohu sí yeshimon» (vaga por el desierto, por el camino desolado)."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 21, :timestamp "2026-07-27T21:57:23.334374592Z", :translated-from :en, :model "glm-5.2"}