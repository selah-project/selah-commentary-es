{:tier :glm-5.2, :verse 18, :comments ["<b>Y ved la tierra, cómo es.</b> Y el pueblo, cómo es." "<b>Fuerte.</b> Para la guerra, y después explicó cómo es la tierra: si es buena, que su aire y sus aguas son buenos."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 13, :timestamp "2026-07-27T21:56:06.403642980Z", :translated-from :en, :model "glm-5.2"}