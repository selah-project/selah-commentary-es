{:tier :glm-5.2, :verse 33, :comments ["<b>Y bajaron.</b> El sentido: cuando bajaron, la tierra se cerró y nunca más fueron vistos." "<b>Y los cubrió.</b> La tierra misma." "<b>Y perecieron.</b> A causa de la muerte de sus hijos que estaban en su lugar."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 16, :timestamp "2026-07-27T21:56:45.397510281Z", :translated-from :en, :model "glm-5.2"}