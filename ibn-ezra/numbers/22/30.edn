{:tier :glm-5.2, :verse 30, :comments ["<b>¿He solido alguna vez?</b> El sentido: desde el día que cabalgaste." "<b>¿He solido — he tenido por costumbre.</b> Lo habitual — he hecho habitual. Y el sentido: así eran mis hábitos de trato con ustedes, e intactos [es decir, sin interrupción]."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T21:57:39.098764020Z", :translated-from :en, :model "glm-5.2"}