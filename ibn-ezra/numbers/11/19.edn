{:tier :glm-5.2, :verse 19, :comments ["<b>No comerás.</b> Duplicado." "<b>Cinco días.</b> Correspondientes a los dedos de la mano con que se come." "<b>Diez.</b> Duplicado con ambas manos, también veinte, como la parábola de quienes dicen: comerá todo lo que come con los dedos de sus manos y de sus pies."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 11, :timestamp "2026-07-27T21:55:50.863523347Z", :translated-from :en, :model "glm-5.2"}