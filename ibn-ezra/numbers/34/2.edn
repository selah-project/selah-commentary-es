{:tier :glm-5.2, :verse 2, :comments ["<b>El la tierra de Canaán.</b> Como 'y la profecía de Oded el profeta' — la profecía es la profecía de Oded el profeta. Y el sentido es <b>el la tierra:</b> la tierra de Canaán."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 34, :timestamp "2026-07-27T21:58:57.278266620Z", :translated-from :en, :model "glm-5.2"}