{:tier :glm-5.2, :verse 11, :comments ["<b>Por mi Señor.</b> Lo he explicado." "<b>Por favor, no.</b> אל = 'ahora no'." "<b>Hemos actuado neciamente.</b> Del binyan nifal, y no tiene cognado excepto נואלו שרי צאן. Algunos dicen que es el inverso de אולת agavado, y su significado es conocido."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 12, :timestamp "2026-07-27T21:56:03.164065800Z", :translated-from :en, :model "glm-5.2"}