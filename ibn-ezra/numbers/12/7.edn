{:tier :glm-5.2, :verse 7, :comments ["<b>En toda Mi casa él es de confianza.</b> Su significado: como un miembro del hogar, que entra sin permiso, y si lo necesita, expresa sus necesidades. Pero tú — cuando Yo me doy a conocer a ti en un sueño, tú sabes; y si no, no tienes permiso para preguntar."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 12, :timestamp "2026-07-27T21:56:00.317793479Z", :translated-from :en, :model "glm-5.2"}