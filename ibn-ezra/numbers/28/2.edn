{:tier :glm-5.2, :verse 2, :comments ["<b>Mi alimento.</b> Ya lo he explicado." "<b>Para Mi fuego.</b> Ya lo he explicado. Y el sentido: alimento para Mi fuego, como aroma agradable." "<b>A su tiempo señalado.</b> Que no lo ofrezcan antes de la mañana ni lo retrasen después de la tarde."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 28, :timestamp "2026-07-27T21:58:21.661923138Z", :translated-from :en, :model "glm-5.2"}