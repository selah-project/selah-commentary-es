{:tier :glm-5.2, :verse 14, :comments ["<b>Un cordero.</b> Macho, como es la regla para toda ofrenda quemada." "<b>Y una oveja.</b> Hembra, como es la regla para toda ofrenda por el pecado." "<b>Y un carnero para ofrendas de paz.</b> Alegría, de que ha completado lo que prometió."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T21:55:13.023883497Z", :translated-from :en, :model "glm-5.2"}