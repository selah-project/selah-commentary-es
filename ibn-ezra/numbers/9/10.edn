{:tier :glm-5.2, :verse 10, :comments ["<b>O en un viaje lejano.</b> No hay nada que investigar, pues los Sabios ya tradujeron cuán lejos está lo lejano." "<b>Para ustedes.</b> Para uno impuro por un cadáver." "<b>O para sus generaciones.</b> En el caso de uno impuro por un cadáver y un viaje lejano."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 9, :timestamp "2026-07-27T21:55:30.382718148Z", :translated-from :en, :model "glm-5.2"}