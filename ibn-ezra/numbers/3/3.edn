{:tier :glm-5.2, :verse 3, :comments ["<b>Los ungidos.</b> Con el aceite de la unción. Porque eran sumos sacerdotes." "Y no dejaron hijos, ya fueran mayores o jóvenes; por eso faltan del número de los lewitas, pues los mayores posiblemente podrían engendrar hijos."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:54:40.782858972Z", :translated-from :en, :model "glm-5.2"}