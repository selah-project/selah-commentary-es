{:tier :glm-5.2, :verse 26, :comments ["<b>Que está sobre el tabernáculo.</b> Porque está dentro del atrio." "<b>Y sobre el altar.</b> Porque está fuera del tabernáculo." "Y el sentido de <b>alrededor</b> es que no falta ningún lugar allí, como una brecha donde no hay cortina." "<b>Para todo su servicio.</b> Todavía lo explicaré."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:54:47.204405632Z", :translated-from :en, :model "glm-5.2"}