{:tier :glm-5.2, :verse 26, :comments ["<b>Toma la cuenta.</b> Lo he explicado." "<b>Del botín.</b> El ganado." "<b>Los cautivos.</b> Las personas, y la vav está ausente, como שמש ירח." "<b>Y los cabezas de las casas paternas de la congregación.</b> Son los príncipes."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 31, :timestamp "2026-07-27T21:58:39.065407614Z", :translated-from :en, :model "glm-5.2"}