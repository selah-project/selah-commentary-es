{:tier :glm-5.2, :verse 50, :comments ["<b>Y acercamos.</b> En pensamiento o en palabra." "<b>Brazalete.</b> Va en el brazo, pues así está escrito." "<b>Y pulsera.</b> Para la mano." "<b>Anillo.</b> En el dedo." "<b>Zarcillo.</b> En las orejas, pues así está escrito. Quizá se llama así porque es redondo." "<b>Y kumaz.</b> Como sus compañeros."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 31, :timestamp "2026-07-27T21:58:44.757848079Z", :translated-from :en, :model "glm-5.2"}