{:tier :glm-5.2, :verse 14, :comments ["<b>Y un espíritu pasa sobre él.</b> Género masculino, asimismo <b>ruach gadolah v'chazakah me'od</b> (un espíritu grande y muy fuerte)." "Y el sentido de <b>pasa sobre</b> es que se eleva en su pensamiento."], :book "numbers", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:55:04.148201674Z", :translated-from :en, :model "glm-5.2"}