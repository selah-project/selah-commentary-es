{:tier :glm-5.2, :verse 20, :comments ["<b>הלא</b> — El sentido es: ¿cómo pueden desear que venga el día, siendo oscuridad? Y la luz es lo que se desea para los ojos, no la oscuridad."], :book "amos", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:01:52.224328554Z", :translated-from :en, :model "glm-5.2"}