{:tier :glm-5.2, :verse 1, :comments ["<b>Ho:</b> Esto es una señal concerniente al exilio de Nabucodonosor." "<b>El designado primero de las naciones:</b> Son Israel, y son llamados 'naciones' porque son numerosos." "<b>Y la casa de Israel viene a ellos:</b> Porque están bajo su dominio."], :book "amos", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T21:01:54.316912652Z", :translated-from :en, :model "glm-5.2"}