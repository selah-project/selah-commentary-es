{:tier :glm-5.2, :verse 8, :comments ["<b>נשבע</b> — Por Sí mismo, como en בי נשבעתי (\"Por Mí mismo he jurado\")." "<b>מתאב</b> — Consumiente, como תאבתי כליתי ונכספתי (\"He anhelado, he sido consumido y he ansiado\")."], :book "amos", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T21:01:23.122781355Z", :translated-from :en, :model "glm-5.2"}