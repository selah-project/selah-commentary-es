{:tier :glm-5.2, :verse 10, :comments ["<b>Yo envié</b> — Maté a tus jóvenes, y tus caballos fueron llevados cautivos." "<b>con fuego en tus campamentos</b> — en la ira de los que pasaban." "<b>y en tu ira</b> — los que quedaban de ellos."], :book "amos", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:01:16.521404635Z", :translated-from :en, :model "glm-5.2"}