{:tier :glm-5.2, :verse 10, :comments ["<b>Y Amasías envió</b> — el sacerdote de Betel era el sacerdote del Baal." "<b>En medio</b> — hablará abiertamente y el pueblo de la tierra no podrá contenerse, soportar, y he aquí si lo haces morir, todos se regocijarán."], :book "amos", :voice :ibn-ezra, :lang :es, :chapter 7, :timestamp "2026-07-27T21:01:37.099677825Z", :translated-from :en, :model "glm-5.2"}