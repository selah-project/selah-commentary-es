{:tier :glm-5.2, :verse 6, :comments ["<b>Un hijo honra al padre</b> — Por el razonamiento del corazón se sabe que un hijo está obligado a honrar al padre, y un siervo está sujeto a su amo, y la respuesta está en «¿en qué te hemos menospreciado?»."], :book "malachi", :voice :ibn-ezra, :lang :es, :chapter 1, :timestamp "2026-07-27T21:52:07.222370158Z", :translated-from :en, :model "glm-5.2"}