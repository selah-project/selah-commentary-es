{:tier :glm-5.2, :verse 37, :comments ["<b>Cada hombre contra su hermano.</b> Que es su amigo." "<b>Te mantendrás firme.</b> Del patrón [binyan] pesado, con una עי״ן añadida [como] vocal de apoyo en lugar de la תי״ו, e igualmente תרומה."], :book "leviticus", :voice :ibn-ezra, :lang :es, :chapter 26, :timestamp "2026-07-27T21:51:52.842079154Z", :translated-from :en, :model "glm-5.2"}