{:tier :glm-5.2, :verse 47, :comments ["<b>Para distinguir entre lo impuro.</b> En las aves y en el enjambre de las aguas." "<b>Que pueden ser comidas.</b> Permitidas para comer." "<b>Que no comeréis.</b> Por ley de la Torá."], :book "leviticus", :voice :ibn-ezra, :lang :es, :chapter 11, :timestamp "2026-07-27T21:48:53.834198719Z", :translated-from :en, :model "glm-5.2"}