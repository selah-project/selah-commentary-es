{:tier :glm-5.2, :verse 16, :comments ["<b>Toda la grosura es para YHWH.</b> Esta es la regla general. Puesto que la grosura y la sangre pertenecen al Altísimo, os están prohibidas. Y en la segunda sección me extenderé para explicar el estatuto perpetuo."], :book "leviticus", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:47:42.656930528Z", :translated-from :en, :model "glm-5.2"}