{:tier :glm-5.2, :verse 2, :comments ["<b>Flujo.</b> Como «flujo de grosura», semejante a gotas que gotean." "<b>De su carne.</b> Un eufemismo para la desnudez del varón." "<b>Su flujo.</b> Un sustantivo."], :book "leviticus", :voice :ibn-ezra, :lang :es, :chapter 15, :timestamp "2026-07-27T21:49:25.521053480Z", :translated-from :en, :model "glm-5.2"}