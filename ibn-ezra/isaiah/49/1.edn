{:tier :glm-5.2, :verse 1, :comments ["<b>Oíd.</b> Estas son las palabras del profeta." "<b>Desde lejos.</b> Los que habitan en tierra lejana, o «desde lejos» con respecto al futuro." "<b>Desde el vientre me llamó.</b> Lo explicaré en el libro de Jeremiah."], :book "isaiah", :voice :ibn-ezra, :lang :es, :chapter 49, :timestamp "2026-07-27T21:38:30.636317449Z", :translated-from :en, :model "glm-5.2"}