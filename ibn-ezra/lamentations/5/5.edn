{:tier :glm-5.2, :verse 5, :comments ["<b>Sobre</b> — Y si traemos el agua o la leña: sobre nuestro cuello somos perseguidos. El enemigo nos persiguió y nos agotó en vano, pues no nos deja descansar de lo que transportábamos."], :book "lamentations", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:47:20.897238193Z", :translated-from :en, :model "glm-5.2"}