{:tier :glm-5.2, :verse 1, :comments ["<b>Recuerda</b> — el recordar está en el corazón y el mirar es con el ojo. Y el sentido es: todo el sufrimiento que pasó sobre nosotros antes del exilio, y el oprobio en el que estamos."], :book "lamentations", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:47:19.679820223Z", :translated-from :en, :model "glm-5.2"}