{:tier :glm-5.2, :verse 15, :comments ["<b>אל מאניא</b> — Dice: como אלה." "<b>שא אזל אחת המו</b> — 'Toma para ti', llévalas, o deposítalas. Esta es la interpretación correcta." "<b>ושא</b> — de וישאו להם נשים, cuyo significado es 'y tomaron'."], :book "ezra", :voice :ibn-ezra, :lang :es, :chapter 5, :timestamp "2026-07-27T21:22:15.161094671Z", :translated-from :en, :model "glm-5.2"}