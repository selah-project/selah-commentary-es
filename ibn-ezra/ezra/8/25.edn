{:tier :glm-5.2, :verse 25, :comments ["<b>ההרימו</b> — El heh es el que se antepone a los verbos transitivos, como <b>ההליכא</b> (el enviar), <b>השבה</b> (el retornar). Y la razón es <b>אשר</b>."], :book "ezra", :voice :ibn-ezra, :lang :es, :chapter 8, :timestamp "2026-07-27T21:22:32.109584678Z", :translated-from :en, :model "glm-5.2"}