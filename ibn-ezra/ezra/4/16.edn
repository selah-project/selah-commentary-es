{:tier :glm-5.2, :verse 16, :comments ["<b>La región más allá del Río no es vuestra</b> — que los pueblos antes mencionados se rebelarán contra ella si se les ordena reconstruir a Jerusalén, o [si] se toma una porción: no tenéis nada más allá del Río; Israel lo tomará todo por la fuerza."], :book "ezra", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:22:10.161236812Z", :translated-from :en, :model "glm-5.2"}