{:tier :glm-5.2, :verse 8, :comments ["<b>el tesorero</b> — el encargado de los tesoros del rey; su significado es un supervisor." "<b>y los contó</b> — los entregó en número." "<b>A Sheshbazzar</b> — él es Zerubbabel, y así se le llamaba en lengua caldea."], :book "ezra", :voice :ibn-ezra, :lang :es, :chapter 1, :timestamp "2026-07-27T21:21:46.307250733Z", :translated-from :en, :model "glm-5.2"}