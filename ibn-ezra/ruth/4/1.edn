{:tier :glm-5.2, :verse 1, :comments ["<b>Hasta la puerta.</b> Tal era la costumbre y la Torá para un tribunal." "<b>Tal hombre, Almoni.</b> Algunos dicen que proviene de 'מופלא', y 'אלמוני' de 'אלם', pues no tiene nombre conocido entre los que hablan."], :book "ruth", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T22:22:00.254305463Z", :translated-from :en, :model "glm-5.2"}