{:tier :glm-5.2, :verse 8, :comments ["<b>Para techar</b> — de קורות בתינו (las vigas de nuestras casas)." "<b>Y para la casa que yo entraré</b> — esta es la casa del rey. Explicó: la casa que yo entraré, pues la casa contigua al muro de la ciudad es el Templo."], :book "nehemiah", :voice :ibn-ezra, :lang :es, :chapter 2, :timestamp "2026-07-27T21:53:38.978323735Z", :translated-from :en, :model "glm-5.2"}