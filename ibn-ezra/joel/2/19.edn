{:tier :glm-5.2, :verse 19, :comments ["<b>ויען</b> — [acerca de] los sacerdotes que lloran." "<b>ושבעתם</b> — [escrito] tanto plene como deficiente." "<b>ולא אתן אתכם</b> — que extenderán [sus manos] para buscar pan, como dijeron: «Egipto ha dado una mano.»"], :book "joel", :voice :ibn-ezra, :lang :es, :chapter 2, :timestamp "2026-07-27T21:45:45.804791210Z", :translated-from :en, :model "glm-5.2"}