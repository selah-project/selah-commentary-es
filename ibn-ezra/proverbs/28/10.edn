{:tier :glm-5.2, :verse 10, :comments ["<b>El que descarría</b> — de su camino; quizá tropezarán en un sendero malo." "<b>cuando lo pervierte</b> — lo que hizo para atraparlos, en ello mismo caerá." "<b>heredarán el bien</b> — después de la muerte del que descarría."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 28, :timestamp "2026-07-27T22:03:54.698126576Z", :translated-from :en, :model "glm-5.2"}