{:tier :glm-5.2, :verse 2, :comments ["<b>Por la transgresión de una tierra</b> — la gente común tiene muchos funcionarios que la destruyen. Y gracias a una persona de entendimiento, que conoce el conocimiento, que los hará volver de su transgresión, así el pueblo perdurará."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 28, :timestamp "2026-07-27T22:03:51.337044315Z", :translated-from :en, :model "glm-5.2"}