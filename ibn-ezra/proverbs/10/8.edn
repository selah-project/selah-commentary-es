{:tier :glm-5.2, :verse 8, :comments ["<b> Sabio de corazón</b> — que la sabiduría está en su corazón." "<b> Tomará mandamientos</b> — que otros le enseñarán." "<b> Y un necio de labios</b> — que sus labios hablarán necedad." "<b> Será derribado</b> — el sentido es, tropezará."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 10, :timestamp "2026-07-27T22:00:36.033479291Z", :translated-from :en, :model "glm-5.2"}