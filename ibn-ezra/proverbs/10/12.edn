{:tier :glm-5.2, :verse 12, :comments ["<b>El odio</b> — es la causa que suscita conflictos, y el amor cubre las transgresiones, y ocultar un asunto es cubrir, como es sabido. El sentido: un hombre de odio y un hombre de amor."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 10, :timestamp "2026-07-27T22:00:36.687391740Z", :translated-from :en, :model "glm-5.2"}