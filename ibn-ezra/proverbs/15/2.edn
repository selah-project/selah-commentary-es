{:tier :glm-5.2, :verse 2, :comments ["<b>Hace bien</b> — del asunto de 'al hacer bien', es decir, el conocimiento está bien establecido." "<b>Derrama</b> — de 'una corriente que fluye', es decir, la necedad no cesa de su boca."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 15, :timestamp "2026-07-27T22:01:34.553537063Z", :translated-from :en, :model "glm-5.2"}