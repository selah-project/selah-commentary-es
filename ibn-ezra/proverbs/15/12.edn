{:tier :glm-5.2, :verse 12, :comments ["<b>No será reprendido</b> — el sentido es reprender." "<b>al sabio</b> — a la casa del sabio." "<b>No irá</b> — porque piensa que lo reprenderán; por eso se aparta de ellos."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 15, :timestamp "2026-07-27T22:01:37.714044002Z", :translated-from :en, :model "glm-5.2"}