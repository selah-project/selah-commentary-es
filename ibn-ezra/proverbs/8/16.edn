{:tier :glm-5.2, :verse 16, :comments ["<b>Por mí gobiernan los príncipes</b> — el juicio concerniente a la resh es que debería llevar un dagesh, como en יִסְבּוּ עָלַי רַבּוּ (Job 30:1), si no fuera porque no recibe un dagesh."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 8, :timestamp "2026-07-27T22:00:11.377527609Z", :translated-from :en, :model "glm-5.2"}