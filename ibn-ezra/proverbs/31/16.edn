{:tier :glm-5.2, :verse 16, :comments ["<b>Ella planeó</b> — Ella consideró comprar un campo." "<b>Del fruto de</b> — Una alusión a la riqueza de su labor manual, es decir: con el fruto de sus manos ella plantó; se plantó una viña para ella, pues no es propio de las mujeres el plantar."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 31, :timestamp "2026-07-27T22:04:33.241093649Z", :translated-from :en, :model "glm-5.2"}