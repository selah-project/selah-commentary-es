{:tier :glm-5.2, :verse 10, :comments ["<b>Mujer de valor, ¿quién hallará:</b> 'Valor' significa riqueza, como en: una mujer que adquiere valor y riqueza mediante su sabiduría — ¿quién la hallará?" "<b>Ella vende:</b> De תמכרו (vosotros [plural] vendéis)."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 31, :timestamp "2026-07-27T22:04:30.545948269Z", :translated-from :en, :model "glm-5.2"}