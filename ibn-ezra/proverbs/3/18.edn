{:tier :glm-5.2, :verse 18, :comments ["<b>Árbol</b> — como un árbol de vida, cuyo fruto da vida a quien come de él por muchos años." "<b>Y los que se aferran a ella</b> — que ella no los abandonará, como él dijo, pues la sabiduría da vida al hombre, que es un mundo pequeño."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:59:35.804381788Z", :translated-from :en, :model "glm-5.2"}