{:tier :glm-5.2, :verse 1, :comments ["<b>Como la nieve</b> — que es impropia en verano, <b>y como la lluvia</b> — que es impropia en la siega; así el honor es impropio para un necio, que otros lo honren."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 26, :timestamp "2026-07-27T22:03:29.865166339Z", :translated-from :en, :model "glm-5.2"}