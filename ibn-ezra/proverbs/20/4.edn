{:tier :glm-5.2, :verse 4, :comments ["<b>Desde el invierno</b> — la mem en lugar de bet, significa: en la época del invierno." "<b>Y pide</b> — que pide a los segadores y no le dan nada, a causa de su pereza."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 20, :timestamp "2026-07-27T22:02:27.417576773Z", :translated-from :en, :model "glm-5.2"}