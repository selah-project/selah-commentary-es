{:tier :glm-5.2, :verse 9, :comments ["<b>Quién</b> — ¿Quién puede decir: 'He purificado mi corazón, estoy limpio de mi pecado'? El significado: no hay persona que camine siempre en su inocencia y no peque."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 20, :timestamp "2026-07-27T22:02:29.113376551Z", :translated-from :en, :model "glm-5.2"}