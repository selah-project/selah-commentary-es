{:tier :glm-5.2, :verse 2, :comments ["<b>El rugido de un león</b> — נהם ככפיר. <b>Quién lo provoca</b> — מתעברו, [es decir] מתעבר עמו. <b>Su alma es la que peca</b>, porque no da honor al reino."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 20, :timestamp "2026-07-27T22:02:26.015722698Z", :translated-from :en, :model "glm-5.2"}