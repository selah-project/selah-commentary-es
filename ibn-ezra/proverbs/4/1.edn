{:tier :glm-5.2, :verse 1, :comments ["<b>Oíd, hijos</b> — Después de amonestar a su hijo, reprendió a otros hijos, para que prestaran atención a la disciplina de su padre, aunque sean tiernos; ante su padre, él es considerado como yo."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:59:39.057300071Z", :translated-from :en, :model "glm-5.2"}