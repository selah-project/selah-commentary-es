{:tier :glm-5.2, :verse 15, :comments ["<b>que cree toda palabra</b> — para apartarse del camino recto." "<b>y el prudente entiende</b> — por su propia prudencia. Y el significado: su camino, del cual no se aparta; por tanto, el temor sabio va tras él."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T22:01:24.054786773Z", :translated-from :en, :model "glm-5.2"}