{:tier :glm-5.2, :verse 6, :comments ["<b>Un escarnecedor busca sabiduría</b> — para enseñar sabiduría." "<b>y no la hay</b> — porque está ocupado en la burla, no puede conocerla." "<b>y conocimiento al entendido</b> — para un hombre entendido es fácil aprender. La recordará, como en (Proverbios 24:14): «y el conocimiento será sweet para tu alma»."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T22:01:20.687536999Z", :translated-from :en, :model "glm-5.2"}