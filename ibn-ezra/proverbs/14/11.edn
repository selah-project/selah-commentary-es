{:tier :glm-5.2, :verse 11, :comments ["<b>ואהל ישרים</b> (y la tienda de los rectos) — que no desean la construcción de casas como los impíos, y que desprecian la lujuria del mundo, y que habitan en tiendas — HaShem los hará permanecer como un árbol floreciente."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 14, :timestamp "2026-07-27T22:01:22.617239970Z", :translated-from :en, :model "glm-5.2"}