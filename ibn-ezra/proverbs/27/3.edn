{:tier :glm-5.2, :verse 3, :comments ["<b>Peso de</b> — estado constructo." "<b>y carga</b> — Targum: וישא. El sentido es el peso de una piedra, y la arena se compara en pesadez por vía de metáfora." "<b>y la ira del necio</b> — más pesada."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 27, :timestamp "2026-07-27T22:03:42.454442725Z", :translated-from :en, :model "glm-5.2"}