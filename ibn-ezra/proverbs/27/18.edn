{:tier :glm-5.2, :verse 18, :comments ["<b>Quien guarda una higuera</b> — Es posible que esté conectado con lo que precede, que uno no sea demasiado duro con su amo, como tampoco con su amigo; y el amo honrará a quien lo guarda de toda cosa mala."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 27, :timestamp "2026-07-27T22:03:47.440896429Z", :translated-from :en, :model "glm-5.2"}