{:tier :glm-5.2, :verse 11, :comments ["<b>Y tu pobreza vendrá como un caminante</b> — como un viajero que llega sin que uno lo sepa hasta su arribo. <b>Y tu necesidad como un hombre de escudo</b> — vendrá como un hombre que viene con un escudo para vencer a otro."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 6, :timestamp "2026-07-27T21:59:52.213865801Z", :translated-from :en, :model "glm-5.2"}