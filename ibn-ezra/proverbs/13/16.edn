{:tier :glm-5.2, :verse 16, :comments ["<b>Todo hombre astuto</b> — aquel cuya astucia está en su corazón hace su obra con conocimiento." "<b>Y el necio esparce su necedad</b> — ante otros. Otra interpretación: actúa en favor del conocimiento, es decir, hace astucia para enseñar conocimiento."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 13, :timestamp "2026-07-27T22:01:15.037335122Z", :translated-from :en, :model "glm-5.2"}