{:tier :glm-5.2, :verse 8, :comments ["<b>No reproches al burlón, no sea que te odie</b> — porque él es sabio a sus propios ojos." "<b>Reprocha a un sabio y te amará</b> — porque él desea la corrección de sus rasgos y no se considera sabio, y son dos opuestos."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 9, :timestamp "2026-07-27T22:00:27.843540660Z", :translated-from :en, :model "glm-5.2"}