{:tier :glm-5.2, :verse 22, :comments ["<b>No, porque es pobre</b> — él lleva sufrimiento en su pobreza, por tanto no lo robes." "<b>En la puerta</b> — porque allí está tu ayuda, como en: «porque veo en la puerta mi ayuda»."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T22:02:55.634895166Z", :translated-from :en, :model "glm-5.2"}