{:tier :glm-5.2, :verse 3, :comments ["<b>Astuto</b> — uno que ha aprendido la astucia: ve el mal que viene y se esconde y se oculta hasta que pasa la ira. Y los impíos atravesaron el mal y fueron castigados, recibieron castigo."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T22:02:49.763901405Z", :translated-from :en, :model "glm-5.2"}