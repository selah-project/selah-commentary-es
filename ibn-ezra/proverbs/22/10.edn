{:tier :glm-5.2, :verse 10, :comments ["<b>Échalo</b> — sepáralo de delante de ti, pues entonces la contienda se va de en medio de ti." "<b>Y cesan los pleitos</b> — para que él no te lleve a juicio, y cesa el oprobio — para que él no te avergüence."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 22, :timestamp "2026-07-27T22:02:52.041061287Z", :translated-from :en, :model "glm-5.2"}