{:tier :glm-5.2, :verse 20, :comments ["<b>Pues no habrá fin</b> — ni futuro para el impío. El significado: no le quedará hijo ni nieto después de su muerte." "<b>Lámpara</b> — que su alma morirá antes de su fin."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 24, :timestamp "2026-07-27T22:03:15.771622331Z", :translated-from :en, :model "glm-5.2"}