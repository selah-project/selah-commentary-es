{:tier :glm-5.2, :verse 22, :comments ["<b>Porque de repente</b> — vendrá sobre ti su calamidad, si no los temes." "<b>Y calamidad</b> — son una sola calamidad, y su sentido es trouble y angustia." "<b>Ambos</b> — HaShem y el rey." "<b>¿Quién sabe?</b> — el momento en que vienen su calamidad y su ruina."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 24, :timestamp "2026-07-27T22:03:16.349916132Z", :translated-from :en, :model "glm-5.2"}