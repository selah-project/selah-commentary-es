{:tier :glm-5.2, :verse 19, :comments ["<b>Su apertura</b> — una alusión a la llave de los labios, es decir: cuando alza su voz para abrir sus palabras para hacer un voto, busca que la ruina venga sobre él por su apertura, de «guarda las aperturas de tu boca»."], :book "proverbs", :voice :ibn-ezra, :lang :es, :chapter 17, :timestamp "2026-07-27T22:02:02.898004916Z", :translated-from :en, :model "glm-5.2"}