{:tier :glm-5.2, :verse 10, :comments ["<b>Y aquel día… la Puerta del Pez</b> — estaba en Yerushalaim." "<b>Desde</b> — la armería, la residencia del segundo del rey, que está dentro de la ciudad." "<b>Y un gran estruendo</b> — fuera de Yerushalaim, pues montañas la rodean."], :book "zephaniah", :voice :ibn-ezra, :lang :es, :chapter 1, :timestamp "2026-07-27T22:24:37.458322350Z", :translated-from :en, :model "glm-5.2"}