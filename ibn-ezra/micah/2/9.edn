{:tier :glm-5.2, :verse 9, :comments ["<b>Mis mujeres</b> — cada mujer entre las mujeres de mi pueblo." "<b>Su deleite</b> — en lo que se deleitaba con su esposo." "<b>Quitáis mi gloria</b> — por la separación del padre de la madre."], :book "micah", :voice :ibn-ezra, :lang :es, :chapter 2, :timestamp "2026-07-27T21:52:38.027065290Z", :translated-from :en, :model "glm-5.2"}