{:tier :glm-5.2, :verse 1, :comments ["<b>Después</b> Después de cinco años. Algunos dicen que este Hamán es Memucán." "<b>Sobre todos los príncipes.</b> El sentido es sobre todos los tronos de los príncipes, pues cada príncipe tiene un trono en el palacio real."], :book "esther", :voice :ibn-ezra, :lang :es, :chapter 3, :timestamp "2026-07-27T21:11:49.025312910Z", :translated-from :en, :model "glm-5.2"}