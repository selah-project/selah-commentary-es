{:tier :glm-5.2, :verse 7, :comments ["<b>Les refirió</b> — de la raíz de explicarles, pues explicó a los oficiales el asunto del dinero." "<b>acerca de los judíos</b> — por causa de los judíos." "<b>Para destruirlos.</b> El sentido es borrar su nombre."], :book "esther", :voice :ibn-ezra, :lang :es, :chapter 4, :timestamp "2026-07-27T21:11:55.866528265Z", :translated-from :en, :model "glm-5.2"}