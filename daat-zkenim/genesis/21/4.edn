{:tier :glm-5.2, :verse 4, :comments ["<b>El hijo de ocho días.</b> Y ahora la práctica común es: cuando traen a un infante a la sinagoga, dicen ברוך הבא, porque הבא asciende a ocho en guematría, y eso es ברוך הנמול a los ocho."], :book "genesis", :voice :daat-zkenim, :lang :es, :chapter 21, :timestamp "2026-07-30T15:25:27.493862002Z", :translated-from :en, :model "glm-5.2"}