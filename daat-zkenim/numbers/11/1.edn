{:tier :glm-5.2, :verse 1, :comments ["<b>Y el pueblo fue como quejumbroso.</b> Como gente que lamenta por los muertos, y afligidos por el hecho de que el Santo, bendito sea, quería llevarlos a la tierra — pues eran de poca fe y estaban ansiosos por la guerra."], :book "numbers", :voice :daat-zkenim, :lang :es, :chapter 11, :timestamp "2026-07-30T15:28:31.569424021Z", :translated-from :en, :model "glm-5.2"}