{:tier :glm-5.2, :verse 10, :comments ["<b>Y acamparon en Obot.</b> Esto significa en Tzelmón y en Punón, que están entre el monte Hor y Obot, como está escrito en אלה מסעי, y allí fue la plaga de las serpientes, y desde allí llegaron después de la plaga a Obot."], :book "numbers", :voice :daat-zkenim, :lang :es, :chapter 21, :timestamp "2026-07-30T15:29:11.731749542Z", :translated-from :en, :model "glm-5.2"}